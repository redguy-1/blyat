quot;Sua mensagem ultrapassa o tamanho m&#195;&#161;ximo de mensagem.&quot;,&quot;zh-cjv&quot;:&quot;&#228;&#189;&#160;&#231;&#154;&#132;&#230;&#182;&#136;&#230;&#129;&#175;&#229;&#183;&#178;&#232;&#182;&#133;&#232;&#191;&#135;&#230;&#156;&#128;&#229;&#164;&#167;&#233;&#149;&#191;&#229;&#186;&#166;&#233;&#153;&#144;&#229;&#136;&#182;&#227;&#128;&#130;&quot;,&quot;it&quot;:&quot;Il tuo messaggio supera la lunghezza massima consentita.&quot;,&quot;fr&quot;:&quot;Votre message d&#195;&#169;passe la longueur maximale.&quot;,&quot;zh-cn&quot;:&quot;&#228;&#189;&#160;&#231;&#154;&#132;&#230;&#182;&#136;&#230;&#129;&#175;&#229;&#183;&#178;&#232;&#182;&#133;&#232;&#191;&#135;&#230;&#156;&#128;&#229;&#164;&#167;&#233;&#149;&#191;&#229;&#186;&#166;&#233;&#153;&#144;&#229;&#136;&#182;&#227;&#128;&#130;&quot;,&quot;ja&quot;:&quot;&#227;&#131;&#161;&#227;&#131;&#131;&#227;&#130;&#187;&#227;&#131;&#188;&#227;&#130;&#184;&#227;&#129;&#140;&#230;&#156;&#128;&#229;&#164;&#167;&#230;&#150;&#135;&#229;&#173;&#151;&#230;&#149;&#176;&#227;&#130;&#146;&#232;&#182;&#133;&#227;&#129;&#136;&#227;&#129;&#166;&#227;&#129;&#132;&#227;&#129;&#190;&#227;&#129;&#153;&#227;&#128;&#130;&quot;,&quot;th-th&quot;:&quot;&#224;&#184;&#130;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&#224;&#184;&#130;&#224;&#184;&#173;&#224;&#184;&#135;&#224;&#184;&#132;&#224;&#184;&#184;&#224;&#184;&#147;&#224;&#184;&#162;&#224;&#184;&#178;&#224;&#184;&#167;&#224;&#185;&#128;&#224;&#184;&#129;&#224;&#184;&#180;&#224;&#184;&#153;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&#224;&#184;&#162;&#224;&#184;&#178;&#224;&#184;&#167;&#224;&#184;&#170;&#224;&#184;&#185;&#224;&#184;&#135;&#224;&#184;&#170;&#224;&#184;&#184;&#224;&#184;&#148;&#224;&#184;&#151;&#224;&#184;&#181;&#224;&#185;&#136;&#224;&#184;&#129;&#224;&#184;&#179;&#224;&#184;&#171;&#224;&#184;&#153;&#224;&#184;&#148;&#224;&#185;&#132;&#224;&#184;&#167;&#224;&#185;&#137;&#224