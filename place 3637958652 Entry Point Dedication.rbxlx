52;&#175;&#229;&#159;&#186;&#230;&#156;&#172;&#232;&#129;&#138;&#229;&#164;&#169;&#229;&#174;&#164;&#230;&#140;&#135;&#228;&#187;&#164;&#227;&#128;&#130;&quot;,&quot;id&quot;:&quot;Ini adalah perintah chat dasar.&quot;,&quot;es-es&quot;:&quot;Estos son los comandos b&#195;&#161;sicos del chat.&quot;,&quot;es&quot;:&quot;Estos son los comandos b&#195;&#161;sicos del chat.&quot;,&quot;pt-br&quot;:&quot;Estes s&#195;&#163;o os comandos de chat b&#195;&#161;sicos.&quot;,&quot;zh-cjv&quot;:&quot;&#232;&#191;&#153;&#228;&#186;&#155;&#230;&#152;&#175;&#229;&#159;&#186;&#230;&#156;&#172;&#232;&#129;&#138;&#229;&#164;&#169;&#230;&#140;&#135;&#228;&#187;&#164;&#227;&#128;&#130;&quot;,&quot;it&quot;:&quot;Questi sono i comandi base della chat.&quot;,&quot;fr&quot;:&quot;Voici les commandes de chat basiques.&quot;,&quot;zh-cn&quot;:&quot;&#232;&#191;&#153;&#228;&#186;&#155;&#230;&#152;&#175;&#229;&#159;&#186;&#230;&#156;&#172;&#232;&#129;&#138;&#229;&#164;&#169;&#230;&#140;&#135;&#228;&#187;&#164;&#227;&#128;&#130;&quot;,&quot;ja&quot;:&quot;&#227;&#129;&#147;&#227;&#130;&#140;&#227;&#130;&#137;&#227;&#129;&#175;&#229;&#159;&#186;&#230;&#156;&#172;&#231;&#154;&#132;&#227;&#129;&#170;&#227;&#131;&#129;&#227;&#131;&#163;&#227;&#131;&#131;&#227;&#131;&#136;&#227;&#130;&#179;&#227;&#131;&#158;&#227;&#131;&#179;&#227;&#131;&#137;&#227;&#129;&#167;&#227;&#129;&#153;&#227;&#128;&#130;&quot;,&quot;th-th&quot;:&quot;&#224;&#184;&#132;&#224;&#184;&#179;&#224;&#184;&#170;&#224;&#184;&#177;&#224;&#185;&#136;&#224;&#184;&#135;&#224;&#185;&#128;&#224;&#184;&#171;&#224;&#184;&#165;&#224;&#185;&#136;&#224;&#184;&#178;&#224;&#184;&#153;&#224;&#184;&#181;&#224;&#185;&#137;&#224;&#185;&#128;&#224;&#184;&#155;&#224;&#185;&#135;&#224;&#184;&#153;&#224;&#184;&#132;&#224;&#184;&#179;&#224;&#184;&#170;&#224;&#184;&#177;&#224;&#185;&#136;&#224;&#184;&#135;&#224;&#185;&#129;&#224;&#184;&#138;&#224;&#184;&#151;&#224;&#185;&#128;&#224;&#184;&#154;&#224;&#184;&#183;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#135;&#224;&#184;&#149;&#224;&#185;&#137;&#224;&#184;&#153;&quot;,&quot;en-us&quot;:&quot;These are the basic chat commands.&quot;,&quot;ko&quot;:&quot;&#235;&#139;&#164;&#236;&#157;&#140;&#236;&#157;&#128; &#234;&#184;&#176;&#235;&#179;&#184;&#236;&#160;&#129;&#236;&#157;&#184; &#236;&#177;&#132;&#237;&#140;&#133; &#235;&#170;&#133;&#235;&#160;&#185;&#236;&#150;&#180;&#236;&#158;&#133;&#235;&#139;&#136;&#235;&#139;&#164;.&quot;}},{&quot;key&quot;:&quot;GameChat_ChatCommandsTeller_MeCommand&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;/me &lt;&#209;&#130;&#208;&#181;&#208;&#186;&#209;&#129;&#209;&#130;&gt; : &#209;&#129;&#208;&#190;&#208;&#190;&#208;&#177;&#209;&#137;&#208;&#184;&#209;&#130;&#209;&#140; &#208;&#190; &#208;&#178;&#209;&#139;&#208;&#191;&#208;&#190;&#208;&#187;&#208;&#189;&#208;&#181;&#208;&#189;&#208;&#184;&#208;&#184; &#208;&#186;&#208;&#176;&#208;&#186;&#208;&#190;&#208;&#179;&#208;&#190;-&#208;&#187;&#208;&#184;&#208;&#177;&#208;&#190; &#208;&#180;&#208;&#181;&#208;&#185;&#209;&#129;&#209;&#130;&#208;&#178;&#208;&#184;&#209;&#143;.&quot;,&quot;pt&quot;:&quot;/me &lt;text&gt; : comando de RPG para realizar a&#195;&#167;&#195;&#181;es.&quot;,&quot;de&quot;:&quot;/me &lt;Text&gt; : Rollenspielbefehl f&#195;&#188;r Aktionen.&quot;,&quot;zh-tw&quot;:&quot;/me &lt;&#230;&#150;&#135;&#229;&#173;&#151;&gt;&#239;&#188;&#154;&#232;&#167;&#146;&#232;&#137;&#178;&#230;&#137;&#174;&#230;&#188;&#148;&#229;&#139;&#149;&#228;&#189;&#156;&#231;&#154;&#132;&#230;&#140;&#135;&#228;&#187;&#164;&#227;&#128;&#130;&quot;,&quot;id&quot;:&quot;/me &lt;text&gt; : perintah roleplay untuk melakukan tindakan.&quot;,&quot;es-es&quot;:&quot;/me &lt;text&gt;: comando de rol para realizar acciones.&quot;,&quot;es&quot;:&quot;/me &lt;text&gt;: comando de rol para realizar acciones.&quot;,&quot;pt-br&quot;:&quot;/me &lt;text&gt; : comando de RPG para realizar a&#195;&#167;&#195;&#181;es.&quot;,&quot;zh-cjv&quot;:&quot;/me &lt;text&gt; : &#229;&#129;&#154;&#229;&#138;&#168;&#228;&#189;&#156;&#231;&#154;&#132;&#232;&#167;&#146;&#232;&#137;&#178;&#230;&#137;&#174;&#230;&#188;&#148;&#230;&#140;&#135;&#228;&#187;&#164;&#227;&#128;&#130;&quot;,&quot;it&quot;:&quot;/me &lt;testo&gt;: comando per descrivere azioni e giocare di ruolo.&quot;,&quot;fr&quot;:&quot;/me &lt;texte&gt;&#194;&#160;: commande jeu de r&#195;&#180;le pour accomplir des actions.&quot;,&quot;zh-cn&quot;:&quot;/me &lt;text&gt; : &#229;&#129;&#154;&#229;&#138;&#168;&#228;&#189;&#156;&#231;&#154;&#132;&#232;&#167;&#146;&#232;&#137;&#178;&#230;&#137;&#174;&#230;&#188;&#148;&#230;&#140;&#135;&#228;&#187;&#164;&#227;&#128;&#130;&quot;,&quot;ja&quot;:&quot;/me &lt;&#227;&#131;&#134;&#227;&#130;&#173;&#227;&#130;&#185;&#227;&#131;&#136;&gt; : &#227;&#130;&#162;&#227;&#130;&#175;&#227;&#130;&#183;&#227;&#131;&#167;&#227;&#131;&#179;&#227;&#129;&#174;&#227;&#129;&#159;&#227;&#130;&#129;&#227;&#129;&#174;&#227;&#131;&#173;&#227;&#131;&#188;&#227;&#131;&#171;&#227;&#131;&#151;&#227;&#131;&#172;&#227;&#130;&#164;&#227;&#131;&#179;&#227;&#130;&#176;&#227;&#130;&#179;&#227;&#131;&#158;&#227;&#131;&#179;&#227;&#131;&#137;&#227;&#128;&#130;&quot;,&quot;th-th&quot;:&quot;/me &lt;&#224;&#184;&#130;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&gt; : &#224;&#184;&#132;&#224;&#184;&#179;&#224;&#184;&#170;&#224;&#184;&#177;&#224;&#185;&#136;&#224;&#184;&#135;&#224;&#185;&#128;&#224;&#184;&#158;&#224;&#184;&#183;&#224;&#185;&#136;&#224;&#184;&#173;&#224;&#184;&#170;&#224;&#184;&#167;&#224;&#184;&#161;&#224;&#184;&#154;&#224;&#184;&#151;&#224;&#184;&#154;&#224;&#184;&#178;&#224;&#184;&#151;&#224;&#185;&#131;&#224;&#184;&#153;&#224;&#184;&#129;&#224;&#184;&#178;&#224;&#184;&#163;&#224;&#184;&#148;&#224;&#184;&#179;&#224;&#185;&#128;&#224;&#184;&#153;&#224;&#184;&#180;&#224;&#184;&#153;&#224;&#184;&#129;&#224;&#184;&#178;&#224;&#184;&#163;&#224;&#184;&#149;&#224;&#185;&#136;&#224;&#184;&#178;&#224;&#184;&#135;&#224;&#185;&#134;&quot;,&quot;en-us&quot;:&quot;/me &lt;text&gt; : roleplaying command for doing actions.&quot;,&quot;ko&quot;:&quot;/me &lt;&#237;&#133;&#141;&#236;&#138;&#164;&#237;&#138;&#184;&gt; : &#236;&#158;&#145;&#236;&#151;&#133; &#236;&#136;&#152;&#237;&#150;&#137;&#236;&#157;&#132; &#236;&#156;&#132;&#237;&#149;&#156; &#235;&#161;&#164;&#237;&#148;&#140;&#235;&#160;&#136;&#236;&#158;&#137; &#235;&#170;&#133;&#235;&#160;&#185;&#236;&#150;&#180;.&quot;}},{&quot;key&quot;:&quot;GameChat_ChatCommandsTeller_MuteCommand&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;/mute &lt;&#208;&#191;&#208;&#190;&#208;&#187;&#209;&#140;&#208;&#183;&#208;&#190;&#208;&#178;&#208;&#176;&#209;&#130;&#208;&#181;&#208;&#187;&#209;&#140;&gt; : &#208;&#184;&#208;&#179;&#208;&#189;&#208;&#190;&#209;&#128;&#208;&#184;&#209;&#128;&#208;&#190;&#208;&#178;&#208;&#176;&#209;&#130;&#209;&#140; &#208;&#191;&#208;&#190;&#208;&#187;&#209;&#140;&#208;&#183;&#208;&#190;&#208;&#178;&#208;&#176;&#209;&#130;&#208;&#181;&#208;&#187;&#209;&#143;.&quot;,&quot;pt&quot;:&quot;/mute &lt;speaker&gt; : silenciar uma pessoa.&quot;,&quot;de&quot;:&quot;/mute &lt;Sprecher&gt; : Schaltet Sprecher:in stumm.&quot;,&quot;zh-tw&quot;:&quot;/mute &lt;&#228;&#189;&#191;&#231;&#148;&#168;&#232;&#128;&#133;&#229;&#144;&#141;&#231;&#168;&#177;&gt; : &#229;&#176;&#135;&#230;&#173;&#164;&#228;&#189;&#191;&#231;&#148;&#168;&#232;&#128;&#133;&#233;&#157;&#156;&#233;&#159;&#179;&#227;&#128;&#130;&quot;,&quot;id&quot;:&quot;/mute &lt;speaker&gt; : bisukan pembicara.&quot;,&quot;es-es&quot;:&quot;/mute &lt;usuario&gt;: silenciar a un usuario.&quot;,&quot;es&quot;:&quot;/mute &lt;usuario&gt;: silenciar a un usuario.&quot;,&quot;pt-br&quot;:&quot;/mute &lt;speaker&gt; : silenciar uma pessoa.&quot;,&quot;zh-cjv&quot;:&quot;/mute &lt;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#144;&#141;&#231;&#167;&#176;&gt;&#239;&#188;&#154;&#229;&#176;&#134;&#231;&#148;&#168;&#230;&#136;&#183;&#231;&#166;&#129;&#232;&#168;&#128;&#227;&#128;&#130;&quot;,&quot;it&quot;:&quot;/mute &lt;giocatore&gt;: togli la parola a un giocatore.&quot;,&quot;fr&quot;:&quot;/mute &lt;interlocuteur&gt;&#194;&#160;: b&#195;&#162;illonne un interlocuteur.&quot;,&quot;zh-cn&quot;:&quot;/mute &lt;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#144;&#141;&#231;&#167;&#176;&gt;&#239;&#188;&#154;&#229;&#176;&#134;&#231;&#148;&#168;&#230;&#136;&#183;&#231;&#166;&#129;&#232;&#168;&#128;&#227;&#128;&#130;&quot;,&quot;ja&quot;:&quot;/mute &lt;&#227;&#130;&#185;&#227;&#131;&#148;&#227;&#131;&#188;&#227;&#130;&#171;&#227;&#131;&#188;&gt; : &#227;&#130;&#185;&#227;&#131;&#148;&#227;&#131;&#188;&#227;&#130;&#171;&#227;&#131;&#188;&#227;&#130;&#146;&#227;&#131;&#159;&#227;&#131;&#165;&#227;&#131;&#188;&#227;&#131;&#136;&#227;&#128;&#130;&quot;,&quot;th-th&quot;:&quot;/mute &lt;&#224;&#184;&#156;&#224;&#184;&#185;&#224;&#185;&#137;&#224;&#185;&#131;&#224;&#184;&#138;&#224;&#185;&#137;&gt; : &#224;&#184;&#155;&#224;&#184;&#180;&#224;&#184;&#148;&#224;&#185;&#128;&#224;&#184;&#170;&#224;&#184;&#181;&#224;&#184;&#162;&#224;&#184;&#135;&#224;&#184;&#156;&#224;&#184;&#185;&#224;&#185;&#137;&#224;&#185;&#131;&#224;&#184;&#138;&#224;&#185;&#137;&quot;,&quot;en-us&quot;:&quot;/mute &lt;speaker&gt; : mute a speaker.&quot;,&quot;ko&quot;:&quot;/mute &lt;&#236;&#138;&#164;&#237;&#148;&#188;&#236;&#187;&#164;&gt; : &#236;&#138;&#164;&#237;&#148;&#188;&#236;&#187;&#164; &#236;&#157;&#140;&#236;&#134;&#140;&#234;&#177;&#176;.&quot;}},{&quot;key&quot;:&quot;GameChat_ChatCommandsTeller_SwitchChannelCommand&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;/c &lt;&#208;&#186;&#208;&#176;&#208;&#189;&#208;&#176;&#208;&#187;&gt; : &#208;&#191;&#208;&#181;&#209;&#128;&#208;&#181;&#208;&#186;&#208;&#187;&#209;&#142;&#209;&#135;&#208;&#184;&#209;&#130;&#209;&#140; &#208;&#178;&#208;&#186;&#208;&#187;&#208;&#176;&#208;&#180;&#208;&#186;&#209;&#131; &#208;&#178; &#208;&#188;&#208;&#181;&#208;&#189;&#209;&#142; &#208;&#186;&#208;&#176;&#208;&#189;&#208;&#176;&#208;&#187;&#208;&#190;&#208;&#178;.&quot;,&quot;pt&quot;:&quot;/c &lt;channel&gt; : trocar abas do menu de canal.&quot;,&quot;de&quot;:&quot;/c &lt;Kanal&gt; : Zum Wechseln zwischen Kanalmen&#195;&#188;reitern.&quot;,&quot;zh-tw&quot;:&quot;/c &lt;&#233;&#160;&#187;&#233;&#129;&#147;&#229;&#144;&#141;&#231;&#168;&#177;&gt;&#239;&#188;&#154;&#229;&#136;&#135;&#230;&#143;&#155;&#233;&#160;&#187;&#233;&#129;&#147;&#233;&#129;&#184;&#229;&#150;&#174;&#230;&#168;&#153;&#231;&#177;&#164;&#227;&#128;&#130;&quot;,&quot;id&quot;:&quot;/c &lt;channel&gt; : tab menu beralih channel.&quot;,&quot;es-es&quot;:&quot;/c &lt;channel&gt;: alternar pesta&#195;&#177;as del men&#195;&#186; del chat.&quot;,&quot;es&quot;:&quot;/c &lt;channel&gt;: alternar pesta&#195;&#177;as del men&#195;&#186; del chat.&quot;,&quot;pt-br&quot;:&quot;/c &lt;channel&gt; : trocar abas do menu de canal.&quot;,&quot;zh-cjv&quot;:&quot;/c &lt;&#233;&#162;&#145;&#233;&#129;&#147;&#229;&#144;&#141;&#231;&#167;&#176;&gt; : &#229;&#136;&#135;&#230;&#141;&#162;&#233;&#162;&#145;&#233;&#129;&#147;&#232;&#143;&#156;&#229;&#141;&#149;&#230;&#160;&#135;&#231;&#173;&#190;&#227;&#128;&#130;&quot;,&quot;it&quot;:&quot;/c &lt;canale&gt;: cambia scheda nel menu dei canali.&quot;,&quot;fr&quot;:&quot;/c &lt;canal&gt;&#194;&#160;: &#195;&#169;changer les onglets du menu Canal.&quot;,&quot;zh-cn&quot;:&quot;/c &lt;&#233;&#162;&#145;&#233;&#129;&#147;&#229;&#144;&#141;&#231;&#167;&#176;&gt; : &#229;&#136;&#135;&#230;&#141;&#162;&#233;&#162;&#145;&#233;&#129;&#147;&#232;&#143;&#156;&#229;&#141;&#149;&#230;&#160;&#135;&#231;&#173;&#190;&#227;&#128;&#130;&quot;,&quot;ja&quot;:&quot;/c &lt;&#227;&#131;&#129;&#227;&#131;&#163;&#227;&#131;&#179;&#227;&#131;&#141;&#227;&#131;&#171;&gt; : &#227;&#131;&#129;&#227;&#131;&#163;&#227;&#131;&#179;&#227;&#131;&#141;&#227;&#131;&#171;&#227;&#131;&#161;&#227;&#131;&#139;&#227;&#131;&#165;&#227;&#131;&#188;&#227;&#130;&#191;&#227;&#131;&#150;&#227;&#130;&#146;&#229;&#136;&#135;&#227;&#130;&#138;&#230;&#155;&#191;&#227;&#129;&#136;&#227;&#130;&#139;&#227;&#128;&#130;&quot;,&quot;th-th&quot;:&quot;/c &lt;&#224;&#185;&#129;&#224;&#184;&#138;&#224;&#184;&#153;&#224;&#185;&#128;&#224;&#184;&#153;&#224;&#184;&#165;&gt; : &#224;&#184;&#170;&#224;&#184;&#165;&#224;&#184;&#177;&#224;&#184;&#154;&#224;&#185;&#129;&#224;&#184;&#151;&#224;&#185;&#135;&#224;&#184;&#154;&#224;&#185;&#128;&#224;&#184;&#161;&#224;&#184;&#153;&#224;&#184;&#185;&#224;&#185;&#129;&#224;&#184;&#138;&#224;&#184;&#153;&#224;&#185;&#128;&#224;&#184;&#153;&#224;&#184;&#165;&quot;,&quot;en-us&quot;:&quot;/c &lt;channel&gt; : switch channel menu tabs.&quot;,&quot;ko&quot;:&quot;/c &lt;&#236;&#177;&#132;&#235;&#132;&#144;&gt; : &#236;&#177;&#132;&#235;&#132;&#144; &#235;&#169;&#148;&#235;&#137;&#180; &#237;&#131;&#173; &#236;&#160;&#132;&#237;&#153;&#152;.&quot;}},{&quot;key&quot;:&quot;GameChat_ChatCommandsTeller_TeamCommand&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;/team &lt;message&gt; &#208;&#184;&#208;&#187;&#208;&#184; /t &lt;message&gt; : &#208;&#190;&#209;&#130;&#208;&#191;&#209;&#128;&#208;&#176;&#208;&#178;&#208;&#184;&#209;&#130;&#209;&#140; &#208;&#179;&#209;&#128;&#209;&#131;&#208;&#191;&#208;&#191;&#208;&#190;&#208;&#178;&#208;&#190;&#208;&#181; &#209;&#129;&#208;&#190;&#208;&#190;&#208;&#177;&#209;&#137;&#208;&#181;&#208;&#189;&#208;&#184;&#208;&#181; &#208;&#186;&#208;&#190;&#208;&#188;&#208;&#176;&#208;&#189;&#208;&#180;&#208;&#181;.&quot;,&quot;pt&quot;:&quot;/team &lt;message&gt; ou /t &lt;message&gt; : enviar um chat de equipe aos membros da sua equipe.&quot;,&quot;de&quot;:&quot;/team &lt;Nachricht&gt; oder /t &lt;Nachricht&gt; : Sendet eine Teamnachricht an Mitglieder deines Teams.&quot;,&quot;zh-tw&quot;:&quot;/team &lt;&#232;&#168;&#138;&#230;&#129;&#175;&gt; &#230;&#136;&#150; /t &lt;&#232;&#168;&#138;&#230;&#129;&#175;&gt; : &#229;&#130;&#179;&#233;&#128;&#129;&#232;&#168;&#138;&#230;&#129;&#175;&#231;&#181;&#166;&#233;&#154;&#138;&#228;&#188;&#141;&#228;&#184;&#173;&#231;&#154;&#132;&#228;&#189;&#191;&#231;&#148;&#168;&#232;&#128;&#133;&#227;&#128;&#130;&quot;,&quot;id&quot;:&quot;/team &lt;message&gt; atau /t &lt;message&gt; : kirim chat tim ke anggota tim kamu.&quot;,&quot;es-es&quot;:&quot;/team &lt;message&gt; o /t &lt;message&gt;: enviar un mensaje de chat a los miembros de tu equipo.&quot;,&quot;es&quot;:&quot;/team &lt;message&gt; o /t &lt;message&gt;: enviar un mensaje de chat a los miembros de tu equipo.&quot;,&quot;pt-br&quot;:&quot;/team &lt;message&gt; ou /t &lt;message&gt; : enviar um chat de equipe aos membros da sua equipe.&quot;,&quot;zh-cjv&quot;:&quot;/team &lt;message&gt; &#230;&#136;&#150; /t &lt;message&gt; : &#229;&#144;&#145;&#228;&#189;&#160;&#231;&#154;&#132;&#233;&#152;&#159;&#229;&#143;&#139;&#229;&#143;&#145;&#233;&#128;&#129;&#232;&#129;&#138;&#229;&#164;&#169;&#228;&#191;&#161;&#230;&#129;&#175;&#227;&#128;&#130;&quot;,&quot;it&quot;:&quot;/team &lt;message&gt; or /t &lt;message&gt; : invia un messaggio chat a tutti i giocatori della tua squadra.&quot;,&quot;fr&quot;:&quot;/team &lt;message&gt; ou /t &lt;message&gt;&#194;&#160;: envoyer un message aux personnes de ton &#195;&#169;quipe.&quot;,&quot;zh-cn&quot;:&quot;/team &lt;message&gt; &#230;&#136;&#150; /t &lt;message&gt; : &#229;&#144;&#145;&#228;&#189;&#160;&#231;&#154;&#132;&#233;&#152;&#159;&#229;&#143;&#139;&#229;&#143;&#145;&#233;&#128;&#129;&#232;&#129;&#138;&#229;&#164;&#169;&#228;&#191;&#161;&#230;&#129;&#175;&#227;&#128;&#130;&quot;,&quot;ja&quot;:&quot;/team &lt;&#227;&#131;&#161;&#227;&#131;&#131;&#227;&#130;&#187;&#227;&#131;&#188;&#227;&#130;&#184;&gt; &#227;&#129;&#190;&#227;&#129;&#159;&#227;&#129;&#175; /t &lt;&#227;&#131;&#161;&#227;&#131;&#131;&#227;&#130;&#187;&#227;&#131;&#188;&#227;&#130;&#184;&gt; : &#232;&#135;&#170;&#229;&#136;&#134;&#227;&#129;&#174;&#227;&#131;&#129;&#227;&#131;&#188;&#227;&#131;&#160;&#227;&#131;&#161;&#227;&#131;&#179;&#227;&#131;&#144;&#227;&#131;&#188;&#227;&#129;&#171;&#227;&#131;&#129;&#227;&#131;&#188;&#227;&#131;&#160;&#227;&#131;&#129;&#227;&#131;&#163;&#227;&#131;&#131;&#227;&#131;&#136;&#227;&#130;&#146;&#233;&#128;&#129;&#227;&#130;&#139;&#227;&#128;&#130;&quot;,&quot;th-th&quot;:&quot;/team &lt;&#224;&#184;&#130;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&gt; &#224;&#184;&#171;&#224;&#184;&#163;&#224;&#184;&#183;&#224;&#184;&#173; /t &lt;&#224;&#184;&#130;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&gt; : &#224;&#184;&#170;&#224;&#185;&#136;&#224;&#184;&#135;&#224;&#185;&#129;&#224;&#184;&#138;&#224;&#184;&#151;&#224;&#184;&#151;&#224;&#184;&#181;&#224;&#184;&#161;&#224;&#185;&#132;&#224;&#184;&#155;&#224;&#184;&#162;&#224;&#184;&#177;&#224;&#184;&#135;&#224;&#184;&#132;&#224;&#184;&#153;&#224;&#185;&#131;&#224;&#184;&#153;&#224;&#184;&#151;&#224;&#184;&#181;&#224;&#184;&#161;&#224;&#184;&#130;&#224;&#184;&#173;&#224;&#184;&#135;&#224;&#184;&#132;&#224;&#184;&#184;&#224;&#184;&#147;&quot;,&quot;en-us&quot;:&quot;/team &lt;message&gt; or /t &lt;message&gt; : send a team chat to people on your team.&quot;,&quot;ko&quot;:&quot;/team &lt;&#235;&#169;&#148;&#236;&#139;&#156;&#236;&#167;&#128;&gt; &#235;&#152;&#144;&#235;&#138;&#148; /t &lt;&#235;&#169;&#148;&#236;&#139;&#156;&#236;&#167;&#128;&gt; : &#237;&#140;&#128; &#235;&#130;&#180; &#237;&#154;&#140;&#236;&#155;&#144;&#236;&#151;&#144;&#234;&#178;&#140; &#237;&#140;&#128; &#236;&#177;&#132;&#237;&#140;&#133; &#236;&#160;&#132;&#236;&#134;&#161;.&quot;}},{&quot;key&quot;:&quot;GameChat_ChatCommandsTeller_UnMuteCommand&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;/unmute &lt;speaker&gt;: &#208;&#191;&#208;&#181;&#209;&#128;&#208;&#181;&#209;&#129;&#209;&#130;&#208;&#176;&#209;&#130;&#209;&#140; &#208;&#184;&#208;&#179;&#208;&#189;&#208;&#190;&#209;&#128;&#208;&#184;&#209;&#128;&#208;&#190;&#208;&#178;&#208;&#176;&#209;&#130;&#209;&#140; &#208;&#191;&#208;&#190;&#208;&#187;&#209;&#140;&#208;&#183;&#208;&#190;&#208;&#178;&#208;&#176;&#209;&#130;&#208;&#181;&#208;&#187;&#209;&#143;.&quot;,&quot;pt&quot;:&quot;/unmute &lt;speaker&gt; : remover sil&#195;&#170;ncio de uma pessoa.&quot;,&quot;de&quot;:&quot;/unmute &lt;Sprecher&gt; : Hebt Stummschaltung eines Sprechers auf.&quot;,&quot;zh-tw&quot;:&quot;/unmute &lt;&#228;&#189;&#191;&#231;&#148;&#168;&#232;&#128;&#133;&#229;&#144;&#141;&#231;&#168;&#177;&gt; : &#229;&#176;&#135;&#230;&#173;&#164;&#228;&#189;&#191;&#231;&#148;&#168;&#232;&#128;&#133;&#232;&#167;&#163;&#233;&#153;&#164;&#233;&#157;&#156;&#233;&#159;&#179;&#227;&#128;&#130;&quot;,&quot;id&quot;:&quot;/unmute &lt;speaker&gt; : bunyikan pembicara.&quot;,&quot;es-es&quot;:&quot;/unmute &lt;speaker&gt;: cancelar silencio de un usuario.&quot;,&quot;es&quot;:&quot;/unmute &lt;speaker&gt;: cancelar silencio de un usuario.&quot;,&quot;pt-br&quot;:&quot;/unmute &lt;speaker&gt; : remover sil&#195;&#170;ncio de uma pessoa.&quot;,&quot;zh-cjv&quot;:&quot;/unmute &lt;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#144;&#141;&#231;&#167;&#176;&gt; : &#229;&#143;&#150;&#230;&#182;&#136;&#232;&#175;&#165;&#231;&#148;&#168;&#230;&#136;&#183;&#231;&#166;&#129;&#232;&#168;&#128;&#227;&#128;&#130;&quot;,&quot;it&quot;:&quot;/unmute &lt;giocatore&gt;: restituisci la parola a un giocatore.&quot;,&quot;fr&quot;:&quot;/unmute &lt;interlocuteur&gt;&#194;&#160;: retire le b&#195;&#162;illon d&apos;un interlocuteur.&quot;,&quot;zh-cn&quot;:&quot;/unmute &lt;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#144;&#141;&#231;&#167;&#176;&gt; : &#229;&#143;&#150;&#230;&#182;&#136;&#232;&#175;&#165;&#231;&#148;&#168;&#230;&#136;&#183;&#231;&#166;&#129;&#232;&#168;&#128;&#227;&#128;&#130;&quot;,&quot;ja&quot;:&quot;/unmute &lt;&#227;&#130;&#185;&#227;&#131;&#148;&#227;&#131;&#188;&#227;&#130;&#171;&#227;&#131;&#188;&gt; : &#227;&#130;&#185;&#227;&#131;&#148;&#227;&#131;&#188;&#227;&#130;&#171;&#227;&#131;&#188;&#227;&#129;&#174;&#227;&#131;&#159;&#227;&#131;&#165;&#227;&#131;&#188;&#227;&#131;&#136;&#227;&#130;&#146;&#232;&#167;&#163;&#233;&#153;&#164;&#227;&#128;&#130;&quot;,&quot;th-th&quot;:&quot;/unmute &lt;&#224;&#184;&#156;&#224;&#184;&#185;&#224;&#185;&#137;&#224;&#185;&#131;&#224;&#184;&#138;&#224;&#185;&#137;&gt; : &#224;&#185;&#128;&#224;&#184;&#165;&#224;&#184;&#180;&#224;&#184;&#129;&#224;&#184;&#155;&#224;&#184;&#180;&#224;&#184;&#148;&#224;&#185;&#128;&#224;&#184;&#170;&#224;&#184;&#181;&#224;&#184;&#162;&#224;&#184;&#135;&#224;&#184;&#156;&#224;&#184;&#185;&#224;&#185;&#137;&#224;&#185;&#131;&#224;&#184;&#138;&#224;&#185;&#137;&quot;,&quot;en-us&quot;:&quot;/unmute &lt;speaker&gt; : unmute a speaker.&quot;,&quot;ko&quot;:&quot;/unmute &lt;&#236;&#138;&#164;&#237;&#148;&#188;&#236;&#187;&#164;&gt; : &#236;&#138;&#164;&#237;&#148;&#188;&#236;&#187;&#164; &#236;&#157;&#140;&#236;&#134;&#140;&#234;&#177;&#176; &#237;&#149;&#180;&#236;&#160;&#156;.&quot;}},{&quot;key&quot;:&quot;GameChat_ChatCommandsTeller_WhisperCommand&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;/whisper &lt;speaker&gt; &#208;&#184;&#208;&#187;&#208;&#184; /w &lt;speaker&gt; : &#208;&#190;&#209;&#130;&#208;&#186;&#209;&#128;&#209;&#139;&#209;&#130;&#209;&#140; &#208;&#186;&#208;&#176;&#208;&#189;&#208;&#176;&#208;&#187; &#208;&#180;&#208;&#187;&#209;&#143; &#208;&#187;&#208;&#184;&#209;&#135;&#208;&#189;&#208;&#190;&#208;&#185; &#208;&#191;&#208;&#181;&#209;&#128;&#208;&#181;&#208;&#191;&#208;&#184;&#209;&#129;&#208;&#186;&#208;&#184; &#209;&#129; &#208;&#191;&#208;&#190;&#208;&#187;&#209;&#140;&#208;&#183;&#208;&#190;&#208;&#178;&#208;&#176;&#209;&#130;&#208;&#181;&#208;&#187;&#208;&#181;&#208;&#188;.&quot;,&quot;pt&quot;:&quot;/whisper &lt;speaker&gt; ou /w &lt;speaker&gt; : abrir um canal de mensagem privada com uma pessoa.&quot;,&quot;de&quot;:&quot;/whisper &lt;Sprecher:in&gt; oder /w &lt;Sprecher:in&gt; : &#195;&#150;ffnet privaten Nachrichtenkanal mit Sprecher:in.&quot;,&quot;zh-tw&quot;:&quot;/whisper &lt;&#228;&#189;&#191;&#231;&#148;&#168;&#232;&#128;&#133;&#229;&#144;&#141;&#231;&#168;&#177;&gt; &#230;&#136;&#150; /w &lt;&#228;&#189;&#191;&#231;&#148;&#168;&#232;&#128;&#133;&#229;&#144;&#141;&#231;&#168;&#177;&gt; : &#232;&#136;&#135;&#230;&#173;&#164;&#228;&#189;&#191;&#231;&#148;&#168;&#232;&#128;&#133;&#233;&#150;&#139;&#229;&#149;&#159;&#231;&#167;&#129;&#228;&#186;&#186;&#232;&#168;&#138;&#230;&#129;&#175;&#233;&#160;&#187;&#233;&#129;&#147;&#227;&#128;&#130;&quot;,&quot;id&quot;:&quot;/whisper &lt;speaker&gt; atau /w &lt;speaker&gt; : buka channel pesan privat dengan pembicara.&quot;,&quot;es-es&quot;:&quot;/whisper &lt;usuario&gt; o /w &lt;usuario&gt;: abrir canal de mensajes privados con un usuario.&quot;,&quot;es&quot;:&quot;/whisper &lt;usuario&gt; o /w &lt;usuario&gt;: abrir canal de mensajes privados con un usuario.&quot;,&quot;pt-br&quot;:&quot;/whisper &lt;speaker&gt; ou /w &lt;speaker&gt; : abrir um canal de mensagem privada com uma pessoa.&quot;,&quot;zh-cjv&quot;:&quot;/whisper &lt;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#144;&#141;&#231;&#167;&#176;&gt; &#230;&#136;&#150; /w &lt;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#144;&#141;&#231;&#167;&#176;&gt; : &#228;&#184;&#142;&#230;&#173;&#164;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#188;&#128;&#229;&#144;&#175;&#231;&#167;&#129;&#228;&#186;&#186;&#230;&#182;&#136;&#230;&#129;&#175;&#233;&#162;&#145;&#233;&#129;&#147;&#227;&#128;&#130;&quot;,&quot;it&quot;:&quot;/whisper &lt;giocatore&gt; o /w &lt;giocatore&gt;: apri un canale privato con un giocatore.&quot;,&quot;fr&quot;:&quot;/whisper &lt;interlocuteur&gt; ou /w &lt;interlocuteur&gt;&#194;&#160;: ouvre un canal de discussion priv&#195;&#169; avec l&apos;interlocuteur.&quot;,&quot;zh-cn&quot;:&quot;/whisper &lt;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#144;&#141;&#231;&#167;&#176;&gt; &#230;&#136;&#150; /w &lt;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#144;&#141;&#231;&#167;&#176;&gt; : &#228;&#184;&#142;&#230;&#173;&#164;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#188;&#128;&#229;&#144;&#175;&#231;&#167;&#129;&#228;&#186;&#186;&#230;&#182;&#136;&#230;&#129;&#175;&#233;&#162;&#145;&#233;&#129;&#147;&#227;&#128;&#130;&quot;,&quot;ja&quot;:&quot;/whisper &lt;&#227;&#130;&#185;&#227;&#131;&#148;&#227;&#131;&#188;&#227;&#130;&#171;&#227;&#131;&#188;&gt; &#227;&#129;&#190;&#227;&#129;&#159;&#227;&#129;&#175; /w &lt;&#227;&#130;&#185;&#227;&#131;&#148;&#227;&#131;&#188;&#227;&#130;&#171;&#227;&#131;&#188;&gt; : &#227;&#131;&#151;&#227;&#131;&#169;&#227;&#130;&#164;&#227;&#131;&#153;&#227;&#131;&#188;&#227;&#131;&#136;&#227;&#131;&#161;&#227;&#131;&#131;&#227;&#130;&#187;&#227;&#131;&#188;&#227;&#130;&#184;&#227;&#131;&#129;&#227;&#131;&#163;&#227;&#131;&#179;&#227;&#131;&#141;&#227;&#131;&#171;&#227;&#130;&#146;&#233;&#150;&#139;&#227;&#129;&#143;&quot;,&quot;th-th&quot;:&quot;/whisper &lt;&#224;&#184;&#156;&#224;&#184;&#185;&#224;&#185;&#137;&#224;&#185;&#131;&#224;&#184;&#138;&#224;&#185;&#137;&gt; or /w &lt;&#224;&#184;&#156;&#224;&#184;&#185;&#224;&#185;&#137;&#224;&#185;&#131;&#224;&#184;&#138;&#224;&#185;&#137;&gt; : &#224;&#185;&#128;&#224;&#184;&#155;&#224;&#184;&#180;&#224;&#184;&#148;&#224;&#185;&#129;&#224;&#184;&#138;&#224;&#184;&#153;&#224;&#185;&#128;&#224;&#184;&#153;&#224;&#184;&#165;&#224;&#185;&#128;&#224;&#184;&#158;&#224;&#184;&#183;&#224;&#185;&#136;&#224;&#184;&#173;&#224;&#185;&#129;&#224;&#184;&#138;&#224;&#184;&#151;&#224;&#184;&#130;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&#224;&#185;&#129;&#224;&#184;&#154;&#224;&#184;&#154;&#224;&#184;&#170;&#224;&#185;&#136;&#224;&#184;&#167;&#224;&#184;&#153;&#224;&#184;&#149;&#224;&#184;&#177;&#224;&#184;&#167;&#224;&#184;&#129;&#224;&#184;&#177;&#224;&#184;&#154;&#224;&#184;&#156;&#224;&#184;&#185;&#224;&#185;&#137;&#224;&#185;&#131;&#224;&#184;&#138;&#224;&#185;&#137;&quot;,&quot;en-us&quot;:&quot;/whisper &lt;speaker&gt; or /w &lt;speaker&gt; : open private message channel with speaker.&quot;,&quot;ko&quot;:&quot;/whisper &lt;&#236;&#130;&#172;&#236;&#154;&#169;&#236;&#158;&#144; &#236;&#157;&#180;&#235;&#166;&#132;&gt; &#235;&#152;&#144;&#235;&#138;&#148; /w &lt;&#236;&#130;&#172;&#236;&#154;&#169;&#236;&#158;&#144; &#236;&#157;&#180;&#235;&#166;&#132;&gt; : &#236;&#130;&#172;&#236;&#154;&#169;&#236;&#158;&#144; &#236;&#177;&#132;&#235;&#132;&#144;&#236;&#151;&#144;&#236;&#132;&#156; &#235;&#185;&#132;&#234;&#179;&#181;&#234;&#176;&#156; &#235;&#169;&#148;&#236;&#139;&#156;&#236;&#167;&#128; &#236;&#151;&#180;&#234;&#184;&#176;.&quot;}},{&quot;key&quot;:&quot;GameChat_ChatFloodDetector_Message&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;&#208;&#157;&#208;&#181;&#208;&#190;&#208;&#177;&#209;&#133;&#208;&#190;&#208;&#180;&#208;&#184;&#208;&#188;&#208;&#190; &#208;&#191;&#208;&#190;&#208;&#180;&#208;&#190;&#208;&#182;&#208;&#180;&#208;&#176;&#209;&#130;&#209;&#140;, &#208;&#191;&#209;&#128;&#208;&#181;&#208;&#182;&#208;&#180;&#208;&#181; &#209;&#135;&#208;&#181;&#208;&#188; &#208;&#190;&#209;&#130;&#208;&#191;&#209;&#128;&#208;&#176;&#208;&#178;&#208;&#187;&#209;&#143;&#209;&#130;&#209;&#140; &#208;&#189;&#208;&#190;&#208;&#178;&#208;&#190;&#208;&#181; &#209;&#129;&#208;&#190;&#208;&#190;&#208;&#177;&#209;&#137;&#208;&#181;&#208;&#189;&#208;&#184;&#208;&#181;!&quot;,&quot;pt&quot;:&quot;Voc&#195;&#170; precisa esperar antes de enviar outra mensagem!&quot;,&quot;de&quot;:&quot;Du musst warten, bevor du eine weitere Nachricht senden kannst!&quot;,&quot;zh-tw&quot;:&quot;&#232;&#171;&#139;&#231;&#168;&#141;&#229;&#190;&#140;&#229;&#134;&#141;&#229;&#130;&#179;&#233;&#128;&#129;&#232;&#168;&#138;&#230;&#129;&#175;&#227;&#128;&#130;&quot;,&quot;id&quot;:&quot;Kamu harus menunggu sebelum mengirim pesan lain.&quot;,&quot;es-es&quot;:&quot;&#194;&#161;Debes esperar antes de enviar otro mensaje!&quot;,&quot;es&quot;:&quot;&#194;&#161;Debes esperar antes de enviar otro mensaje!&quot;,&quot;pt-br&quot;:&quot;Voc&#195;&#170; precisa esperar antes de enviar outra mensagem!&quot;,&quot;zh-cjv&quot;:&quot;&#229;&#143;&#145;&#233;&#128;&#129;&#229;&#143;&#166;&#228;&#184;&#128;&#230;&#157;&#161;&#230;&#182;&#136;&#230;&#129;&#175;&#229;&#137;&#141;&#228;&#189;&#160;&#229;&#191;&#133;&#233;&#161;&#187;&#231;&#173;&#137;&#229;&#190;&#133;&#239;&#188;&#129;&quot;,&quot;it&quot;:&quot;Devi aspettare prima di inviare un altro messaggio!&quot;,&quot;fr&quot;:&quot;Vous devez attendre avant d&apos;envoyer un autre message&#194;&#160;!&quot;,&quot;zh-cn&quot;:&quot;&#229;&#143;&#145;&#233;&#128;&#129;&#229;&#143;&#166;&#228;&#184;&#128;&#230;&#157;&#161;&#230;&#182;&#136;&#230;&#129;&#175;&#229;&#137;&#141;&#228;&#189;&#160;&#229;&#191;&#133;&#233;&#161;&#187;&#231;&#173;&#137;&#229;&#190;&#133;&#239;&#188;&#129;&quot;,&quot;ja&quot;:&quot;&#229;&#176;&#145;&#227;&#129;&#151;&#229;&#190;&#133;&#227;&#129;&#163;&#227;&#129;&#166;&#227;&#129;&#139;&#227;&#130;&#137;&#230;&#172;&#161;&#227;&#129;&#174;&#227;&#131;&#161;&#227;&#131;&#131;&#227;&#130;&#187;&#227;&#131;&#188;&#227;&#130;&#184;&#227;&#130;&#146;&#233;&#128;&#129;&#227;&#129;&#163;&#227;&#129;&#166;&#227;&#129;&#143;&#227;&#129;&#160;&#227;&#129;&#149;&#227;&#129;&#132;!&quot;,&quot;th-th&quot;:&quot;&#224;&#184;&#132;&#224;&#184;&#184;&#224;&#184;&#147;&#224;&#184;&#136;&#224;&#184;&#179;&#224;&#185;&#128;&#224;&#184;&#155;&#224;&#185;&#135;&#224;&#184;&#153;&#224;&#184;&#149;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#135;&#224;&#184;&#163;&#224;&#184;&#173;&#224;&#184;&#129;&#224;&#185;&#136;&#224;&#184;&#173;&#224;&#184;&#153;&#224;&#184;&#151;&#224;&#184;&#181;&#224;&#185;&#136;&#224;&#184;&#136;&#224;&#184;&#176;&#224;&#184;&#170;&#224;&#185;&#136;&#224;&#184;&#135;&#224;&#184;&#130;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&#224;&#184;&#173;&#224;&#184;&#183;&#224;&#185;&#136;&#224;&#184;&#153;&#224;&#184;&#149;&#224;&#185;&#136;&#224;&#184;&#173;!&quot;,&quot;en-us&quot;:&quot;You must wait before sending another message!&quot;,&quot;ko&quot;:&quot;&#236;&#182;&#148;&#234;&#176;&#128; &#235;&#169;&#148;&#236;&#139;&#156;&#236;&#167;&#128;&#235;&#165;&#188; &#235;&#179;&#180;&#235;&#130;&#180;&#234;&#184;&#176; &#236;&#160;&#132;&#236;&#151;&#144; &#234;&#184;&#176;&#235;&#139;&#164;&#235;&#160;&#164;&#236;&#149;&#188; &#237;&#149;&#180;&#236;&#154;&#148;!&quot;}},{&quot;key&quot;:&quot;GameChat_ChatFloodDetector_MessageDisplaySeconds&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;&#208;&#162;&#209;&#139; &#209;&#129;&#208;&#188;&#208;&#190;&#208;&#182;&#208;&#181;&#209;&#136;&#209;&#140; &#208;&#190;&#209;&#130;&#208;&#191;&#209;&#128;&#208;&#176;&#208;&#178;&#208;&#184;&#209;&#130;&#209;&#140; &#208;&#189;&#208;&#190;&#208;&#178;&#208;&#190;&#208;&#181; &#209;&#129;&#208;&#190;&#208;&#190;&#208;&#177;&#209;&#137;&#208;&#181;&#208;&#189;&#208;&#184;&#208;&#181; &#209;&#130;&#208;&#190;&#208;&#187;&#209;&#140;&#208;&#186;&#208;&#190; &#209;&#135;&#208;&#181;&#209;&#128;&#208;&#181;&#208;&#183; {RBX_NUMBER} &#209;&#129;!&quot;,&quot;pt&quot;:&quot;Voc&#195;&#170; precisa esperar {RBX_NUMBER} segundos antes de enviar outra mensagem!&quot;,&quot;de&quot;:&quot;Du musst {RBX_NUMBER} Sekunden lang warten, bevor du eine weitere Nachricht senden kannst!&quot;,&quot;zh-tw&quot;:&quot;&#232;&#171;&#139; {RBX_NUMBER} &#231;&#167;&#146;&#229;&#190;&#140;&#229;&#134;&#141;&#229;&#130;&#179;&#233;&#128;&#129;&#232;&#168;&#138;&#230;&#129;&#175;&#227;&#128;&#130;&quot;,&quot;id&quot;:&quot;Kamu harus menunggu {RBX_NUMBER} detik sebelum mengirim pesan lain.&quot;,&quot;es-es&quot;:&quot;&#194;&#161;Debes esperar {RBX_NUMBER} segundos antes de enviar otro mensaje!&quot;,&quot;es&quot;:&quot;&#194;&#161;Debes esperar {RBX_NUMBER} segundos antes de enviar otro mensaje!&quot;,&quot;pt-br&quot;:&quot;Voc&#195;&#170; precisa esperar {RBX_NUMBER} segundos antes de enviar outra mensagem!&quot;,&quot;zh-cjv&quot;:&quot;&#229;&#143;&#145;&#233;&#128;&#129;&#229;&#143;&#166;&#228;&#184;&#128;&#230;&#157;&#161;&#230;&#182;&#136;&#230;&#129;&#175;&#229;&#137;&#141;&#228;&#189;&#160;&#229;&#191;&#133;&#233;&#161;&#187;&#231;&#173;&#137;&#229;&#190;&#133; {RBX_NUMBER} &#231;&#167;&#146;&#239;&#188;&#129;&quot;,&quot;it&quot;:&quot;Devi aspettare {RBX_NUMBER} secondi prima di inviare un altro messaggio!&quot;,&quot;fr&quot;:&quot;Vous devez attendre {RBX_NUMBER}&#194;&#160;secondes avant d&apos;envoyer un autre message&#194;&#160;!&quot;,&quot;zh-cn&quot;:&quot;&#229;&#143;&#145;&#233;&#128;&#129;&#229;&#143;&#166;&#228;&#184;&#128;&#230;&#157;&#161;&#230;&#182;&#136;&#230;&#129;&#175;&#229;&#137;&#141;&#228;&#189;&#160;&#229;&#191;&#133;&#233;&#161;&#187;&#231;&#173;&#137;&#229;&#190;&#133; {RBX_NUMBER} &#231;&#167;&#146;&#239;&#188;&#129;&quot;,&quot;ja&quot;:&quot;{RBX_NUMBER} &#231;&#167;&#146;&#229;&#190;&#133;&#227;&#129;&#163;&#227;&#129;&#166;&#227;&#129;&#139;&#227;&#130;&#137;&#230;&#172;&#161;&#227;&#129;&#174;&#227;&#131;&#161;&#227;&#131;&#131;&#227;&#130;&#187;&#227;&#131;&#188;&#227;&#130;&#184;&#227;&#130;&#146;&#233;&#128;&#129;&#227;&#129;&#163;&#227;&#129;&#166;&#227;&#129;&#143;&#227;&#129;&#160;&#227;&#129;&#149;&#227;&#129;&#132;!&quot;,&quot;th-th&quot;:&quot;&#224;&#184;&#132;&#224;&#184;&#184;&#224;&#184;&#147;&#224;&#184;&#136;&#224;&#184;&#179;&#224;&#185;&#128;&#224;&#184;&#155;&#224;&#185;&#135;&#224;&#184;&#153;&#224;&#184;&#149;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#135;&#224;&#184;&#163;&#224;&#184;&#173;&#224;&#185;&#128;&#224;&#184;&#155;&#224;&#185;&#135;&#224;&#184;&#153;&#224;&#185;&#128;&#224;&#184;&#167;&#224;&#184;&#165;&#224;&#184;&#178; {RBX_NUMBER} &#224;&#184;&#167;&#224;&#184;&#180;&#224;&#184;&#153;&#224;&#184;&#178;&#224;&#184;&#151;&#224;&#184;&#181;&#224;&#184;&#129;&#224;&#185;&#136;&#224;&#184;&#173;&#224;&#184;&#153;&#224;&#184;&#151;&#224;&#184;&#181;&#224;&#185;&#136;&#224;&#184;&#136;&#224;&#184;&#176;&#224;&#184;&#170;&#224;&#185;&#136;&#224;&#184;&#135;&#224;&#184;&#130;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&#224;&#184;&#173;&#224;&#184;&#183;&#224;&#185;&#136;&#224;&#184;&#153;&#224;&#184;&#149;&#224;&#185;&#136;&#224;&#184;&#173;!&quot;,&quot;en-us&quot;:&quot;You must wait {RBX_NUMBER} seconds before sending another message!&quot;,&quot;ko&quot;:&quot;&#236;&#182;&#148;&#234;&#176;&#128; &#235;&#169;&#148;&#236;&#139;&#156;&#236;&#167;&#128;&#235;&#165;&#188; &#235;&#179;&#180;&#235;&#130;&#180;&#234;&#184;&#176; &#236;&#160;&#132;&#236;&#151;&#144; {RBX_NUMBER}&#236;&#180;&#136; &#235;&#143;&#153;&#236;&#149;&#136; &#234;&#184;&#176;&#235;&#139;&#164;&#235;&#160;&#164;&#236;&#149;&#188; &#237;&#149;&#180;&#236;&#154;&#148;!&quot;}},{&quot;key&quot;:&quot;GameChat_ChatMain_ChatBarText&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;&#208;&#167;&#209;&#130;&#208;&#190;&#208;&#177;&#209;&#139; &#208;&#190;&#208;&#177;&#209;&#137;&#208;&#176;&#209;&#130;&#209;&#140;&#209;&#129;&#209;&#143; &#208;&#178; &#209;&#135;&#208;&#176;&#209;&#130;&#208;&#181;, &#208;&#189;&#208;&#176;&#208;&#182;&#208;&#188;&#208;&#184; &#208;&#183;&#208;&#180;&#208;&#181;&#209;&#129;&#209;&#140; &#208;&#184;&#208;&#187;&#208;&#184; &#208;&#189;&#208;&#176; &#208;&#186;&#208;&#187;&#208;&#176;&#208;&#178;&#208;&#184;&#209;&#136;&#209;&#131; &#194;&#171;/&#194;&#187;&quot;,&quot;pt&quot;:&quot;Para escrever clique aqui ou aperte a tecla \&quot;/\&quot;&quot;,&quot;de&quot;:&quot;Klicke zum Chatten hier oder dr&#195;&#188;cke die &#226;&#128;&#158;/&#226;&#128;&#156;-Taste.&quot;,&quot;zh-tw&quot;:&quot;&#232;&#139;&#165;&#232;&#166;&#129;&#232;&#129;&#138;&#229;&#164;&#169;&#239;&#188;&#140;&#232;&#171;&#139;&#230;&#140;&#137;&#228;&#184;&#139;&#230;&#173;&#164;&#232;&#153;&#149;&#230;&#136;&#150;&#227;&#128;&#140;/&#227;&#128;&#141;&#233;&#141;&#181;&quot;,&quot;id&quot;:&quot;Untuk chat, klik di sini atau tekan tombol \&quot;/\&quot;&quot;,&quot;es-es&quot;:&quot;Para chatear, haz clic aqu&#195;&#173; o pulsa la tecla \&quot;/\&quot;.&quot;,&quot;es&quot;:&quot;Para chatear, haz clic aqu&#195;&#173; o pulsa la tecla \&quot;/\&quot;.&quot;,&quot;pt-br&quot;:&quot;Para escrever clique aqui ou aperte a tecla \&quot;/\&quot;&quot;,&quot;zh-cjv&quot;:&quot;&#232;&#139;&#165;&#232;&#166;&#129;&#232;&#129;&#138;&#229;&#164;&#169;&#239;&#188;&#140;&#232;&#175;&#183;&#231;&#130;&#185;&#230;&#140;&#137;&#230;&#173;&#164;&#229;&#164;&#132;&#230;&#136;&#150;&#230;&#140;&#137;&#228;&#184;&#139;&#226;&#128;&#156;/&#226;&#128;&#157;&#233;&#148;&#174;&quot;,&quot;it&quot;:&quot;Per chattare, clicca qui o premi il tasto \&quot;/\&quot;&quot;,&quot;fr&quot;:&quot;Pour discuter, cliquez ici ou sur la touche &#194;&#171;&#194;&#160;/&#194;&#160;&#194;&#187;&quot;,&quot;zh-cn&quot;:&quot;&#232;&#139;&#165;&#232;&#166;&#129;&#232;&#129;&#138;&#229;&#164;&#169;&#239;&#188;&#140;&#232;&#175;&#183;&#231;&#130;&#185;&#230;&#140;&#137;&#230;&#173;&#164;&#229;&#164;&#132;&#230;&#136;&#150;&#230;&#140;&#137;&#228;&#184;&#139;&#226;&#128;&#156;/&#226;&#128;&#157;&#233;&#148;&#174;&quot;,&quot;ja&quot;:&quot;&#227;&#131;&#129;&#227;&#131;&#163;&#227;&#131;&#131;&#227;&#131;&#136;&#227;&#129;&#153;&#227;&#130;&#139;&#227;&#129;&#171;&#227;&#129;&#175;&#227;&#129;&#147;&#227;&#129;&#147;&#227;&#130;&#146;&#227;&#130;&#175;&#227;&#131;&#170;&#227;&#131;&#131;&#227;&#130;&#175;&#227;&#129;&#153;&#227;&#130;&#139;&#227;&#129;&#139; &#227;&#128;&#140; / &#227;&#128;&#141; &#227;&#130;&#173;&#227;&#131;&#188;&#227;&#130;&#146;&#230;&#138;&#188;&#227;&#129;&#151;&#227;&#129;&#190;&#227;&#129;&#153;&#227;&#128;&#130;&quot;,&quot;th-th&quot;:&quot;&#224;&#184;&#132;&#224;&#184;&#165;&#224;&#184;&#180;&#224;&#184;&#129;&#224;&#184;&#151;&#224;&#184;&#181;&#224;&#185;&#136;&#224;&#184;&#153;&#224;&#184;&#181;&#224;&#185;&#136;&#224;&#184;&#171;&#224;&#184;&#163;&#224;&#184;&#183;&#224;&#184;&#173;&#224;&#184;&#129;&#224;&#184;&#148;&#224;&#184;&#151;&#224;&#184;&#181;&#224;&#185;&#136; \&quot;/\&quot; &#224;&#185;&#128;&#224;&#184;&#158;&#224;&#184;&#183;&#224;&#185;&#136;&#224;&#184;&#173;&#224;&#185;&#128;&#224;&#184;&#163;&#224;&#184;&#180;&#224;&#185;&#136;&#224;&#184;&#161;&#224;&#185;&#129;&#224;&#184;&#138;&#224;&#184;&#151;&quot;,&quot;en-us&quot;:&quot;To chat click here or press \&quot;/\&quot; key&quot;,&quot;ko&quot;:&quot;&#236;&#151;&#172;&#234;&#184;&#176;&#235;&#165;&#188; &#237;&#129;&#180;&#235;&#166;&#173;&#237;&#149;&#152;&#234;&#177;&#176;&#235;&#130;&#152; \&quot;/\&quot; &#237;&#130;&#164;&#235;&#165;&#188; &#235;&#136;&#132;&#235;&#165;&#184; &#237;&#155;&#132; &#236;&#177;&#132;&#237;&#140;&#133;&#236;&#157;&#132; &#236;&#139;&#156;&#236;&#158;&#145;&#237;&#149;&#152;&#236;&#132;&#184;&#236;&#154;&#148;&quot;}},{&quot;key&quot;:&quot;GameChat_ChatMain_ChatBarTextTouch&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;&#208;&#154;&#208;&#190;&#209;&#129;&#208;&#189;&#208;&#184;&#209;&#129;&#209;&#140; &#208;&#183;&#208;&#180;&#208;&#181;&#209;&#129;&#209;&#140;, &#209;&#135;&#209;&#130;&#208;&#190;&#208;&#177;&#209;&#139; &#208;&#190;&#208;&#177;&#209;&#137;&#208;&#176;&#209;&#130;&#209;&#140;&#209;&#129;&#209;&#143; &#208;&#178; &#209;&#135;&#208;&#176;&#209;&#130;&#208;&#181;&quot;,&quot;pt&quot;:&quot;Toque aqui para escrever&quot;,&quot;de&quot;:&quot;Tippe zum Chatten hier.&quot;,&quot;zh-tw&quot;:&quot;&#230;&#140;&#137;&#228;&#184;&#139;&#230;&#173;&#164;&#232;&#153;&#149;&#232;&#129;&#138;&#229;&#164;&#169;&quot;,&quot;id&quot;:&quot;Ketuk di sini untuk chat&quot;,&quot;es-es&quot;:&quot;Toca aqu&#195;&#173; para chatear&quot;,&quot;es&quot;:&quot;Toca aqu&#195;&#173; para chatear&quot;,&quot;pt-br&quot;:&quot;Toque aqui para escrever&quot;,&quot;zh-cjv&quot;:&quot;&#232;&#189;&#187;&#231;&#130;&#185;&#230;&#173;&#164;&#229;&#164;&#132;&#228;&#187;&#165;&#232;&#129;&#138;&#229;&#164;&#169;&quot;,&quot;it&quot;:&quot;Tocca qui per chattare&quot;,&quot;fr&quot;:&quot;Touchez ici pour discuter&quot;,&quot;zh-cn&quot;:&quot;&#232;&#189;&#187;&#231;&#130;&#185;&#230;&#173;&#164;&#229;&#164;&#132;&#228;&#187;&#165;&#232;&#129;&#138;&#229;&#164;&#169;&quot;,&quot;ja&quot;:&quot;&#227;&#129;&#147;&#227;&#129;&#147;&#227;&#130;&#146;&#227;&#130;&#191;&#227;&#131;&#131;&#227;&#131;&#151;&#227;&#129;&#151;&#227;&#129;&#166;&#227;&#131;&#129;&#227;&#131;&#163;&#227;&#131;&#131;&#227;&#131;&#136;&#227;&#129;&#153;&#227;&#130;&#139;&quot;,&quot;th-th&quot;:&quot;&#224;&#185;&#129;&#224;&#184;&#149;&#224;&#184;&#176;&#224;&#184;&#151;&#224;&#184;&#181;&#224;&#185;&#136;&#224;&#184;&#153;&#224;&#184;&#181;&#224;&#185;&#136;&#224;&#185;&#128;&#224;&#184;&#158;&#224;&#184;&#183;&#224;&#185;&#136;&#224;&#184;&#173;&#224;&#185;&#129;&#224;&#184;&#138;&#224;&#184;&#151;&quot;,&quot;en-us&quot;:&quot;Tap here to chat&quot;,&quot;ko&quot;:&quot;&#236;&#151;&#172;&#234;&#184;&#176;&#235;&#165;&#188; &#237;&#129;&#180;&#235;&#166;&#173;&#237;&#149;&#156; &#237;&#155;&#132; &#235;&#130;&#180;&#236;&#154;&#169;&#236;&#157;&#132; &#236;&#158;&#133;&#235;&#160;&#165;&#237;&#149;&#152;&#236;&#132;&#184;&#236;&#154;&#148;&quot;}},{&quot;key&quot;:&quot;GameChat_ChatMain_ChatTranslationOnboarding&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;&#208;&#148;&#208;&#190;&#209;&#129;&#209;&#130;&#209;&#131;&#208;&#191;&#208;&#181;&#208;&#189; &#208;&#191;&#208;&#181;&#209;&#128;&#208;&#181;&#208;&#178;&#208;&#190;&#208;&#180; &#209;&#130;&#208;&#181;&#208;&#186;&#209;&#129;&#209;&#130;&#208;&#190;&#208;&#178;&#208;&#190;&#208;&#179;&#208;&#190; &#209;&#135;&#208;&#176;&#209;&#130;&#208;&#176;. &#208;&#157;&#208;&#176;&#208;&#182;&#208;&#188;&#208;&#184; &#208;&#189;&#208;&#176; &#209;&#129;&#208;&#184;&#208;&#188;&#208;&#178;&#208;&#190;&#208;&#187; &#208;&#191;&#208;&#181;&#209;&#128;&#208;&#181;&#208;&#180; &#209;&#129;&#208;&#190;&#208;&#190;&#208;&#177;&#209;&#137;&#208;&#181;&#208;&#189;&#208;&#184;&#208;&#181;&#208;&#188;, &#209;&#135;&#209;&#130;&#208;&#190;&#208;&#177;&#209;&#139; &#209;&#131;&#208;&#178;&#208;&#184;&#208;&#180;&#208;&#181;&#209;&#130;&#209;&#140; &#208;&#190;&#209;&#128;&#208;&#184;&#208;&#179;&#208;&#184;&#208;&#189;&#208;&#176;&#208;&#187;. &#208;&#159;&#208;&#181;&#209;&#128;&#208;&#181;&#208;&#178;&#208;&#190;&#208;&#180; &#208;&#188;&#208;&#190;&#208;&#182;&#208;&#189;&#208;&#190; &#208;&#190;&#209;&#130;&#208;&#186;&#208;&#187;&#209;&#142;&#209;&#135;&#208;&#184;&#209;&#130;&#209;&#140; &#208;&#178; &#208;&#157;&#208;&#176;&#209;&#129;&#209;&#130;&#209;&#128;&#208;&#190;&#208;&#185;&#208;&#186;&#208;&#176;&#209;&#133;.&quot;,&quot;pt&quot;:&quot;O chat de texto ser&#195;&#161; traduzido para seu idioma. Toque no s&#195;&#173;mbolo na frente da mensagem para ver o original. Voc&#195;&#170; pode desativar as tradu&#195;&#167;&#195;&#181;es no menu de configura&#195;&#167;&#195;&#181;es.&quot;,&quot;de&quot;:&quot;Der Textchat wird in deine Sprache &#195;&#188;bersetzt. Tippe auf das Symbol vor der Nachricht, um sie in der Originalsprache anzuzeigen. Du kannst &#195;&#156;bersetzungen im Men&#195;&#188; \&quot;Einstellungen\&quot; ausschalten.&quot;,&quot;zh-tw&quot;:&quot;&#230;&#150;&#135;&#229;&#173;&#151;&#228;&#186;&#164;&#232;&#171;&#135;&#230;&#156;&#131;&#231;&#191;&#187;&#232;&#173;&#175;&#231;&#130;&#186;&#230;&#130;&#168;&#230;&#133;&#163;&#231;&#148;&#168;&#231;&#154;&#132;&#232;&#170;&#158;&#232;&#168;&#128;&#227;&#128;&#130;&#232;&#171;&#139;&#232;&#188;&#149;&#232;&#167;&#184;&#232;&#168;&#138;&#230;&#129;&#175;&#229;&#137;&#141;&#231;&#154;&#132;&#231;&#172;&#166;&#232;&#153;&#159;&#239;&#188;&#140;&#230;&#159;&#165;&#231;&#156;&#139;&#229;&#142;&#159;&#230;&#150;&#135;&#227;&#128;&#130;&#230;&#130;&#168;&#229;&#143;&#175;&#228;&#187;&#165;&#229;&#156;&#168;&#227;&#128;&#140;&#232;&#168;&#173;&#229;&#174;&#154;&#227;&#128;&#141;&#233;&#129;&#184;&#229;&#150;&#174;&#233;&#151;&#156;&#233;&#150;&#137;&#231;&#191;&#187;&#232;&#173;&#175;&#227;&#128;&#130;&quot;,&quot;id&quot;:&quot;Chat teks akan diterjemahkan ke dalam bahasa kamu. Ketuk simbol di depan pesan untuk melihat pesan orisinal. Kamu dapat mematikan terjemahan di menu Pengaturan.&quot;,&quot;es-es&quot;:&quot;El chat de texto se traducir&#195;&#161; a tu idioma. Toca el s&#195;&#173;mbolo delante del mensaje para ver el original. Puedes desactivar las traducciones en el men&#195;&#186; Configuraci&#195;&#179;n.&quot;,&quot;es&quot;:&quot;El chat de texto se traducir&#195;&#161; a tu idioma. Toca el s&#195;&#173;mbolo delante del mensaje para ver el original. Puedes desactivar las traducciones en el men&#195;&#186; Configuraci&#195;&#179;n.&quot;,&quot;pt-br&quot;:&quot;O chat de texto ser&#195;&#161; traduzido para seu idioma. Toque no s&#195;&#173;mbolo na frente da mensagem para ver o original. Voc&#195;&#170; pode desativar as tradu&#195;&#167;&#195;&#181;es no menu de configura&#195;&#167;&#195;&#181;es.&quot;,&quot;zh-cjv&quot;:&quot;&#230;&#150;&#135;&#230;&#156;&#172;&#232;&#129;&#138;&#229;&#164;&#169;&#229;&#176;&#134;&#232;&#162;&#171;&#231;&#191;&#187;&#232;&#175;&#145;&#232;&#135;&#179;&#228;&#189;&#160;&#231;&#154;&#132;&#232;&#175;&#173;&#232;&#168;&#128;&#227;&#128;&#130;&#231;&#130;&#185;&#230;&#140;&#137;&#230;&#182;&#136;&#230;&#129;&#175;&#229;&#137;&#141;&#233;&#157;&#162;&#231;&#154;&#132;&#231;&#172;&#166;&#229;&#143;&#183;&#239;&#188;&#140;&#230;&#159;&#165;&#231;&#156;&#139;&#229;&#142;&#159;&#229;&#167;&#139;&#230;&#150;&#135;&#230;&#156;&#172;&#227;&#128;&#130; &#228;&#189;&#160;&#229;&#143;&#175;&#228;&#187;&#165;&#229;&#156;&#168;&#226;&#128;&#156;&#232;&#174;&#190;&#231;&#189;&#174;&#226;&#128;&#157;&#232;&#143;&#156;&#229;&#141;&#149;&#228;&#184;&#173;&#229;&#133;&#179;&#233;&#151;&#173;&#231;&#191;&#187;&#232;&#175;&#145;&#227;&#128;&#130;&quot;,&quot;it&quot;:&quot;La chat di testo verr&#195;&#160; tradotta nella tua lingua. Tocca il simbolo di fronte al messaggio per vedere l&apos;originale. Puoi disattivare le traduzioni nel menu Impostazioni.&quot;,&quot;fr&quot;:&quot;Le texte du chat sera traduit dans ta langue. Touche le symbole devant le message pour voir l&apos;original. Tu peux d&#195;&#169;sactiver les traductions dans le menu Param&#195;&#168;tres.&quot;,&quot;zh-cn&quot;:&quot;&#230;&#150;&#135;&#230;&#156;&#172;&#232;&#129;&#138;&#229;&#164;&#169;&#229;&#176;&#134;&#232;&#162;&#171;&#231;&#191;&#187;&#232;&#175;&#145;&#232;&#135;&#179;&#228;&#189;&#160;&#231;&#154;&#132;&#232;&#175;&#173;&#232;&#168;&#128;&#227;&#128;&#130;&#231;&#130;&#185;&#230;&#140;&#137;&#230;&#182;&#136;&#230;&#129;&#175;&#229;&#137;&#141;&#233;&#157;&#162;&#231;&#154;&#132;&#231;&#172;&#166;&#229;&#143;&#183;&#239;&#188;&#140;&#230;&#159;&#165;&#231;&#156;&#139;&#229;&#142;&#159;&#229;&#167;&#139;&#230;&#150;&#135;&#230;&#156;&#172;&#227;&#128;&#130; &#228;&#189;&#160;&#229;&#143;&#175;&#228;&#187;&#165;&#229;&#156;&#168;&#226;&#128;&#156;&#232;&#174;&#190;&#231;&#189;&#174;&#226;&#128;&#157;&#232;&#143;&#156;&#229;&#141;&#149;&#228;&#184;&#173;&#229;&#133;&#179;&#233;&#151;&#173;&#231;&#191;&#187;&#232;&#175;&#145;&#227;&#128;&#130;&quot;,&quot;ja&quot;:&quot;&#227;&#131;&#134;&#227;&#130;&#173;&#227;&#130;&#185;&#227;&#131;&#136;&#227;&#131;&#129;&#227;&#131;&#163;&#227;&#131;&#131;&#227;&#131;&#136;&#227;&#129;&#140;&#232;&#168;&#173;&#229;&#174;&#154;&#232;&#168;&#128;&#232;&#170;&#158;&#227;&#129;&#171;&#231;&#191;&#187;&#232;&#168;&#179;&#227;&#129;&#149;&#227;&#130;&#140;&#227;&#129;&#190;&#227;&#129;&#153;&#227;&#128;&#130;&#229;&#142;&#159;&#230;&#150;&#135;&#227;&#130;&#146;&#232;&#166;&#139;&#227;&#130;&#139;&#227;&#129;&#171;&#227;&#129;&#175;&#227;&#128;&#129;&#227;&#131;&#161;&#227;&#131;&#131;&#227;&#130;&#187;&#227;&#131;&#188;&#227;&#130;&#184;&#227;&#129;&#174;&#229;&#137;&#141;&#227;&#129;&#171;&#227;&#129;&#130;&#227;&#130;&#139;&#231;&#191;&#187;&#232;&#168;&#179;&#227;&#131;&#158;&#227;&#131;&#188;&#227;&#130;&#175;&#227;&#130;&#146;&#227;&#130;&#191;&#227;&#131;&#131;&#227;&#131;&#151;&#227;&#129;&#151;&#227;&#129;&#166;&#227;&#129;&#143;&#227;&#129;&#160;&#227;&#129;&#149;&#227;&#129;&#132;&#227;&#128;&#130;&#231;&#191;&#187;&#232;&#168;&#179;&#227;&#129;&#175;&#232;&#168;&#173;&#229;&#174;&#154;&#227;&#131;&#161;&#227;&#131;&#139;&#227;&#131;&#165;&#227;&#131;&#188;&#227;&#129;&#167;&#227;&#130;&#170;&#227;&#131;&#149;&#227;&#129;&#171;&#227;&#129;&#167;&#227;&#129;&#141;&#227;&#129;&#190;&#227;&#129;&#153;&#227;&#128;&#130;&quot;,&quot;th-th&quot;:&quot;&#224;&#184;&#130;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&#224;&#185;&#131;&#224;&#184;&#153;&#224;&#185;&#129;&#224;&#184;&#138;&#224;&#184;&#151;&#224;&#184;&#136;&#224;&#184;&#176;&#224;&#185;&#132;&#224;&#184;&#148;&#224;&#185;&#137;&#224;&#184;&#163;&#224;&#184;&#177;&#224;&#184;&#154;&#224;&#184;&#129;&#224;&#184;&#178;&#224;&#184;&#163;&#224;&#185;&#129;&#224;&#184;&#155;&#224;&#184;&#165;&#224;&#185;&#128;&#224;&#184;&#155;&#224;&#185;&#135;&#224;&#184;&#153;&#224;&#184;&#160;&#224;&#184;&#178;&#224;&#184;&#169;&#224;&#184;&#178;&#224;&#184;&#130;&#224;&#184;&#173;&#224;&#184;&#135;&#224;&#184;&#132;&#224;&#184;&#184;&#224;&#184;&#147; &#224;&#185;&#129;&#224;&#184;&#149;&#224;&#184;&#176;&#224;&#184;&#170;&#224;&#184;&#177;&#224;&#184;&#141;&#224;&#184;&#165;&#224;&#184;&#177;&#224;&#184;&#129;&#224;&#184;&#169;&#224;&#184;&#147;&#224;&#185;&#140;&#224;&#184;&#171;&#224;&#184;&#153;&#224;&#185;&#137;&#224;&#184;&#178;&#224;&#184;&#130;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&#224;&#185;&#128;&#224;&#184;&#158;&#224;&#184;&#183;&#224;&#185;&#136;&#224;&#184;&#173;&#224;&#184;&#148;&#224;&#184;&#185;&#224;&#184;&#130;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&#224;&#185;&#131;&#224;&#184;&#153;&#224;&#184;&#160;&#224;&#184;&#178;&#224;&#184;&#169;&#224;&#184;&#178;&#224;&#184;&#149;&#224;&#185;&#137;&#224;&#184;&#153;&#224;&#184;&#137;&#224;&#184;&#154;&#224;&#184;&#177;&#224;&#184;&#154; &#224;&#184;&#132;&#224;&#184;&#184;&#224;&#184;&#147;&#224;&#184;&#170;&#224;&#184;&#178;&#224;&#184;&#161;&#224;&#184;&#178;&#224;&#184;&#163;&#224;&#184;&#150;&#224;&#184;&#155;&#224;&#184;&#180;&#224;&#184;&#148;&#224;&#184;&#129;&#224;&#184;&#178;&#224;&#184;&#163;&#224;&#185;&#129;&#224;&#184;&#155;&#224;&#184;&#165;&#224;&#184;&#160;&#224;&#184;&#178;&#224;&#184;&#169;&#224;&#184;&#178;&#224;&#185;&#132;&#224;&#184;&#148;&#224;&#185;&#137;&#224;&#185;&#131;&#224;&#184;&#153;&#224;&#185;&#128;&#224;&#184;&#161;&#224;&#184;&#153;&#224;&#184;&#185;&#224;&#184;&#129;&#224;&#184;&#178;&#224;&#184;&#163;&#224;&#184;&#149;&#224;&#184;&#177;&#224;&#185;&#137;&#224;&#184;&#135;&#224;&#184;&#132;&#224;&#185;&#136;&#224;&#184;&#178;&quot;,&quot;en-us&quot;:&quot;Text chat will be translated into your language. Tap the symbol in front of the message to see the original. You can turn off translations in the Settings menu.&quot;,&quot;ko&quot;:&quot;&#237;&#133;&#141;&#236;&#138;&#164;&#237;&#138;&#184; &#236;&#177;&#132;&#237;&#140;&#133;&#236;&#157;&#180; &#236;&#130;&#172;&#236;&#154;&#169;&#236;&#158;&#144;&#236;&#157;&#152; &#236;&#150;&#184;&#236;&#150;&#180;&#235;&#161;&#156; &#235;&#178;&#136;&#236;&#151;&#173;&#235;&#144;&#169;&#235;&#139;&#136;&#235;&#139;&#164;. &#235;&#169;&#148;&#236;&#139;&#156;&#236;&#167;&#128; &#236;&#149;&#158;&#236;&#157;&#152; &#234;&#184;&#176;&#237;&#152;&#184;&#235;&#165;&#188; &#237;&#131;&#173;&#237;&#149;&#152;&#235;&#169;&#180; &#236;&#157;&#180;&#235;&#165;&#188; &#236;&#155;&#144;&#235;&#158;&#152; &#236;&#150;&#184;&#236;&#150;&#180;&#235;&#161;&#156; &#237;&#153;&#149;&#236;&#157;&#184;&#237;&#149;&#160; &#236;&#136;&#152; &#236;&#158;&#136;&#236;&#138;&#181;&#235;&#139;&#136;&#235;&#139;&#164;. &#236;&#132;&#164;&#236;&#160;&#149; &#235;&#169;&#148;&#235;&#137;&#180;&#236;&#151;&#144;&#236;&#132;&#156; &#235;&#178;&#136;&#236;&#151;&#173; &#234;&#184;&#176;&#235;&#138;&#165;&#236;&#157;&#132; &#235;&#129;&#140; &#236;&#136;&#152; &#236;&#158;&#136;&#236;&#138;&