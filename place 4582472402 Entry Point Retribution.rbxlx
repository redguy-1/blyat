&#172;&#236;&#154;&#169;&#236;&#158;&#144; &#236;&#157;&#180;&#235;&#166;&#132;&gt; &#235;&#152;&#144;&#235;&#138;&#148; /w &lt;&#236;&#130;&#172;&#236;&#154;&#169;&#236;&#158;&#144; &#236;&#157;&#180;&#235;&#166;&#132;&gt; : &#236;&#130;&#172;&#236;&#154;&#169;&#236;&#158;&#144; &#236;&#177;&#132;&#235;&#132;&#144;&#236;&#151;&#144;&#236;&#132;&#156; &#235;&#185;&#132;&#234;&#179;&#181;&#234;&#176;&#156; &#235;&#169;&#148;&#236;&#139;&#156;&#236;&#167;&#128; &#236;&#151;&#180;&#234;&#184;&#176;.&quot;}},{&quot;key&quot;:&quot;GameChat_ChatFloodDetector_Message&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;&#208;&#157;&#208;&#181;&#208;&#190;&#208;&#177;&#209;&#133;&#208;&#190;&#208;&#180;&#208;&#184;&#208;&#188;&#208;&#190; &#208;&#191;&#208;&#190;&#208;&#180;&#208;&#190;&#208;&#182;&#208;&#180;&#208;&#176;&#209;&#130;&#209;&#140;, &#208;&#191;&#209;&#128;&#208;&#181;&#208;&#182;&#208;&#180;&#208;&#181; &#209;&#135;&#208;&#181;&#208;&#188; &#208;&#190;&#209;&#130;&#208;&#191;&#209;&#128;&#208;&#176;&#208;&#178;&#208;&#187;&#209;&#143;&#209;&#130;&#209;&#140; &#208;&#189;&#208;&#190;&#208;&#178;&#208;&#190;&#208;&#181; &#209;&#129;&#208;&#190;&#208;&#190;&#208;&#177;&#209;&#137;&#208;&#181;&#208;&#189;&#208;&#184;&#208;&#181;!&quot;,&quot;pt&quot;:&quot;Voc&#195;&#170; precisa esperar antes de enviar outra mensagem!&quot;,&quot;de&quot;:&quot;Du musst warten, bevor du eine weitere Nachricht senden kannst!&quot;,&quot;zh-tw&quot;:&quot;&#232;&#171;&#139;&#231;&#168;&#141;&#229;&#190;&#140;&#229;&#134;&#141;&#229;&#130;&#179;&#233;&#128;&#129;&#232;&#168;&#138;&#230;&#129;&#175;&#227;&#128;&#130;&quot;,&quot;id&quot;:&quot;Kamu harus menunggu sebelum mengirim pesan lain.&quot;,&quot;es-es&quot;:&quot;&#194;&#161;Debes esperar antes de enviar otro mensaje!&quot;,&quot;es&quot;:&quot;&#194;&#161;Debes esperar antes de enviar otro mensaje!&quot;,&quot;pt-br&quot;:&quot;Voc&#195;&#170; precisa esperar antes de enviar outra mensagem!&quot;,&quot;zh-cjv&quot;:&quot;&#229;&#143;&#145;&#233;&#128;&#129;&#229;&#143;&#166;&#228;&#184;&#128;&#230;&#157;&#161;&#230;&#182;&#136;&#230;&#129;&#175;&#229;&#137;&#141;&#228;&#189;&#160;&#229;&#191;&#133;&#233;&#161;&#187;&#231;&#173;&#137;&#229;&#190;&#133;&#239;&#188;&#129;&quot;,&quot;it&quot;:&quot;Devi aspettare prima di inviare un altro messaggio!&quot;,&quot;fr&quot;:&quot;Vous devez attendre avant d&apos;envoyer un autre message&#194;&#160;!&quot;,&quot;zh-cn&quot;:&quot;&#229;&#143;&#145;&#233;&#128;&#129;&#229;&#143;&#166;&#228;&#184;&#128;&#230;&#157;&#161;&#230;&#182;&#136;&#230;&#129;&#175;&#229;&#137;&#141;&#228;&#189;&#160;&#229;&#191;&#133;&#233;&#161;&#187;&#231;&#173;&#137;&#229;&#190;&#133;&#239;&#188;&#129;&quot;,&quot;ja&quot;:&quot;&#229;&#176;&#145;&#227;&#129;&#151;&#229;&#190;&#133;&#227;&#129;&#163;&#227;&#129;&#166;&#227;&#129;&#139;&#227;&#130;&#137;&#230;&#172;&#161;&#227;&#129;&#174;&#227;&#131;&#161;&#227;&#131;&#131;&#227;&#130;&#187;&#227;&#131;&#188;&#227;&#130;&#184;&#227;&#130;&#146;&#233;&#128;&#129;&#227;&#129;&#163;&#227;&#129;&#166;&#227;&#129;&#143;&#227;&#129;&#160;&#227;&#129;&#149;&#227;&#129;&#132;!&quot;,&quot;th-th&quot;:&quot;&#224;&#184;&#132;&#224;&#184;&#184;&#224;&#184;&#147;&#224;&#184;&#136;&#224;&#184;&#179;&#224;&#185;&#128;&#224;&#184;&#155;&#224;&#185;&#135;&#224;&#184;&#153;&#224;&#184;&#149;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#135;&#224;&#184;&#163;&#224;&#184;&#173;&#224;&#184;&#129;&#224;&#185;&#136;&#224;&#184;&#173;&#224;&#184;&#153;&#224;&#184;&#151;&#224;&#184;&#181;&#224;&#185;&#136;&#224;&#184;&#136;&#224;&#184;&#176;&#224;&#184;&#170;&#224;&#185;&#136;&#224;&#184;&#135;&#224;&#184;&#130;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&#224;&#184;&#173;&#224;&#184;&#183;&#224;&#185;&#136;&#224;&#184;&#153;&#224;&#184;&#149;&#224;&#185;&#136;&#224;&#184;&#173;!&quot;,&quot;en-us&quot;:&quot;You must wait before sending another message!&quot;,&quot;ko&quot;:&q