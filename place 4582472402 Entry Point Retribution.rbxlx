;&#129;&#175;&#229;&#137;&#141;&#228;&#189;&#160;&#229;&#191;&#133;&#233;&#161;&#187;&#231;&#173;&#137;&#229;&#190;&#133; {RBX_NUMBER} &#231;&#167;&#146;&#239;&#188;&#129;&quot;,&quot;it&quot;:&quot;Devi aspettare {RBX_NUMBER} secondi prima di inviare un altro messaggio!&quot;,&quot;fr&quot;:&quot;Vous devez attendre {RBX_NUMBER}&#194;&#160;secondes avant d&apos;envoyer un autre message&#194;&#160;!&quot;,&quot;zh-cn&quot;:&quot;&#229;&#143;&#145;&#233;&#128;&#129;&#229;&#143;&#166;&#228;&#184;&#128;&#230;&#157;&#161;&#230;&#182;&#136;&#230;&#129;&#175;&#229;&#137;&#141;&#228;&#189;&#160;&#229;&#191;&#133;&#233;&#161;&#187;&#231;&#173;&#137;&#229;&#190;&#133; {RBX_NUMBER} &#231;&#167;&#146;&#239;&#188;&#129;&quot;,&quot;ja&quot;:&quot;{RBX_NUMBER} &#231;&#167;&#146;&#229;&#190;&#133;&#227;&#129;&#163;&#227;&#129;&#166;&#227;&#129;&#139;&#227;&#130;&#137;&#230;&#172;&#161;&#227;&#129;&#174;&#227;&#131;&#161;&#227;&#131;&#131;&#227;&#130;&#187;&#227;&#131;&#188;&#227;&#130;&#184;&#227;&#130;&#146;&#233;&#128;&#129;&#227;&#129;&#163;&#227;&#129;&#166;&#227;&#129;&#143;&#227;&#129;&#160;&#227;&#129;&#149;&#227;&#129;&#132;!&quot;,&quot;th-th&quot;:&quot;&#224;&#184;&#132;&#224;&#184;&#184;&#224;&#184;&#147;&#224;&#184;&#136;&#224;&#184;&#179;&#224;&#185;&#128;&#224;&#184;&#155;&#224;&#185;&#135;&#224;&#184;&#153;&#224;&#184;&#149;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#135;&#224;&#184;&#163;&#224;&#184;&#173;&#224;&#185;&#128;&#224;&#184;&#155;&#224;&#185;&#135;&#224;&#184;&#153;&#224;&#185;&#128;&#224;&#184;&#167;&#224;&#184;&#165;&#224;&#184;&#178; {RBX_NUMBER} &#224;&#184;&#167;&#224;&#184;&#180;&#224;&#184;&#153;&#224;&#184;&#178;&#224;&#184;&#151;&#224;&#184;&#181;&#224;&#184;&#129;&#224;&#185;&#136;&#224;&#184;&#173;&#224;&#184;&#153;&#224;&#184;&#151;&#224;&#184;&#181;&#224;&#185;&#136;&#224;&#184;&#136;&#224;&#184;&#176;&#224;&#184;&#170;&#224;&#185;&#136;&#224;&#184;&#135;&#224;&#184;&#130;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&#224;&#184;&#173;&#224;&#184;&#183;&#224;&#185;&#136;&#224;&#184;&#153;&#224;&#184;&#149;&#224;&#185;&#136;&#224;&#184;&#173;!&quot;,&quot;en-us&quot;:&quot;You must wait {RBX_NUMBER} seconds before sending another message!&quot;,&quot;ko&quot;:&quot;&#236;&#182;&#148;&#234;&#176;&#128; &#235;&#169;&#148;&#236;&#139;&#156;&#236;&#167;&#128;&#235;&#165;&#188; &#235;&#179;&#180;&#235;&#130;&#180;&#234;&#184;&#176; &#236;&#160;&#132;&#236;&#151;&#144; {RBX_NUMBER}&#236;&#180;&#136; &#235;&#143;&#153;&#236;&#149;&#136; &#234;&#184;&#176;&#235;&#139;&#164;&#235;&#160;&#164;&#236;&#149;&#188; &#237;&#149;&#180;&#236;&#154;&#148;!&quot;}},{&quot;key&quot;:&quot;GameChat_ChatMain_ChatBarText&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;&#208;&#167;&#209;&#130;&#208;&#190;&#208;&#177;&#209;&#139; &#208;&#190;&#208;&#177;&#209;&#137;&#208;&#176;&#209;&#130;&#209;&#140;&#209;&#129;&#209;&#143; &#208;&#178; &#209;&#135;&#208;&#176;&#209;&#130;&#208;&#181;, &#208;&#189;&#208;&#176;&#208;&#182;&#208;&#188;&#208;&#184; &#208;&#183;&#208;&#180;&#208;&#181;&#209;&#129;&#209;&#140; &#208;&#184;&#208;&#187;&#208;&#184; &#208;&#189;&#208;&#176; &#208;&#186;&#208;&#187;&#208;&#176;&#208;&#178;&#208;&#184;&#209;&#136;&#209;&#131; &#194;&#171;/&#194;&#187;&quot;,&quot;pt&quot;:&quot;Para escrever clique aqui ou aperte a tecla \&quot;/\&quot;&quot;,&quot;de&quot;:&quot;Klicke zum Chatten hier oder dr&#195;&#188;cke die &#226;&#128;&#158;/&#226;&#128;&#156;-Taste.&quot;,&quot;zh-tw&quot;:&quot;&#232;&#139;&#165;&#232;&#166;&#129;&#232;&#129;&#138;&#229;&#164;&#169;&#239;&#188;&#140;&#232;&#171;&#139;&#230;&#140;&#137;&#228;&#184;&#139;&#230;&#173;&#164;&#232;&#153;&#149;&#230;&#136;&#150;&#227;&#128;&#140;/&#227;&#128;&#141;&#233;&#141;&#181;&quot;,&quot;id&quot;:&quot;Untuk chat, klik di sini atau tekan tombol \&quot;/\&quot;&quot;,&quot;es-es&quot;:&quot;Para chatear, haz clic aqu&#195;&#173; o pulsa la tecla \&quot;/\&quot;.&quot;,&quot;es&quot;:&quot;Para chatear, haz clic aqu&#195;&#173; o pulsa la tecla \&quot;/\&quot;.&quot;,&quot;pt-br&quot;:&quot;Para escrever clique aqui ou aperte a tecla \&quot;/\&quot;&quot;,&quot;zh-cjv&quot;:&quot;&#232;&#139;&#165;&#232;&#166;&#129;&#232;&#129;&#138;&#229;&#164;&#169;&#239;&#188;&#140;&#232;&#175;&#183;&#231;&#130;&#185;&#230;&#140;&#137;&#230;&#173;&#164;&#229;&#164;&#132;&#230;&#136;&#150;&#230;&#140;&#137;&#228;&#184;&#139;&#226;&#128;&#156;/&#226;&#128;&#157;&#233;&#148;&#174;&quot;,&quot;it&quot;:&quot;Per chattare, clicca qui o premi il tasto \&quot;/\&quot;&quot;,&quot;fr&quot;:&quot;Pour discuter, cliquez ici ou sur la touche &#194;&#171;&#194;&#160;/&#194;&#160;&#194;&#187;&quot;,&quot;zh-cn&quot;:&quot;&#232;&#139;&#165;&#232;&#166;&#129;&#232;&#129;&#138;&#229;&#164;&#169;&#239;&#188;&#140;&#232;&#175;&#183;&#231;&#130;&#185;&#230;&#140;&#137;&#230;&#173;&#164;&#229;&#164;&#132;&#230;&#136;&#150;&#230;&#140;&#137;&#228;&#184;&#139;&#226;&#128;&#156;/&#226;&#128;&#157;&#233;&#148;&#174;&quot;,&quot;ja&quot;:&quot;&#227;&#131;&#129;&#227;&#131;&#163;&#227;&#131;&#131;&#227;&#131;&#136;&#227;&#129;&#153;&#227;&#130;&#139;&#227;&#129;&#171;&#227;&#129;&#175;&#227;&#129;&#147;&#227;&#129;&#147;&#227;&#130;&#146;&#227;&#130;&#175;&#227;&#131;&#170;&#227;&#131;&#131;&#227;&#130;&#175;&#227;&#129;&#153;&#227;&#130;&#139;&#227;&#129;&#139; &#227;&#128;&#140; / &#227;&#128;&#141; &#227;&#130;&#173;&#227;&#131;&#188;&#227;&#130;&#146;&#230;&#138;&#188;&#227;&#129;&#151;&#227;&#129;&#190;&#227;&#129;&#153;&#227;&#128;&#130;&quot;,&quot;th-th&quot;:&quot;&#224;&#184;&#132;&#224;&#184;&#165;&#224;&#184;&#180;&#224;&#184;&#129;&#224;&#184;&#151;&#224;&#184;&#181;&#224;&#185;&#136;&#224;&#184;&#153;&#224;&#184;&#181;&#224;&#185;&#136;&#224;&#184;&#171;&#224;&#184;&#163;&#224;&#184;&#183;&#224;&#184;&#173;&#224;&#184;&#129;&#224;&#184;&#148;&#224;&#184;&#151;&#224;&#184;&#181;&#224;&#185;&#136; \&quot;/\&quot; &#224;&#185;&#128;&#224;&#184;&#158;&#224;&#184;&#183;&#224;&#185;&#136;&#224;&#184;&#173;&#224;&#185;&#128;&#224;&#184;&#163;&#224;&#184;&#180;&#224;&#185;&#136;&#224;&#184;&#161;&#224;&#185;&#129;&#224;&#184;&#138;&#224;&#184;&#151;&quot;,&quot;en-us&quot;:&quot;To chat click here or press \&quot;/\&quot; key&quot;,&quot;ko&quot;:&quot;&#236;&#151;&#172;&#234;&#184;&#176;&#235;&#165;&#188; &#237;&#129;&#180;&#235;&#166;&#173;&#237;&#149;&#152;&#234;&#177;&#176;&#235;&#130;&#152; \&quot;/\&quot; &#237;&#130;&#164;&#235;&#165;&#188; &#235;&#136;&#132;&#235;&#165;&#184; &#237;&#155;&#132; &#236;&#177;&#132;&#237;&#140;&#133;&#236;&#157;&#132; &#236;&#139;&#156;&#236;&#158;&#145;&#237;&#149;&#152;&#236;&#132;&#184;&#236;&#154;&#148;&quot;}},{&quot;key&quot;:&quot;GameChat_ChatMain_ChatBarTextTouch&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;&#208;&#154;&#208;&#190;&#209;&#129;&#208;&#189;&#208;&#184;&#209;&#129;&#209;&#140; &#208;&#183;&#208;&#180;&#208;&#181;&#209;&#129;&#209;&#140;, &#209;&#135;&#209;&#130;&#208;&#190;&#208;&#177;&#209;&#139; &#208;&#190;&#208;&#177;&#209;&#137;&#208;&#176;&#209;&#130;&#209;&#140;&#209;&#129;&#209;&#143; &#208;&#178; &#209;&#135;&#208;&#176;&#209;&#130;&#208;&#181;&quot;,&quot;pt&quot;:&quot;Toque aqui para escrever&quot;,&quot;de&quot;:&quot;Tippe zum Chatten hier.&quot;,&quot;zh-tw&quot;:&quot;&#230;&#140;&#137;&#228;&#184;&#139;&#230;&#173;&#164;&#232;&#153;&#149;&#232;&#129;&#138;&#229;&#164;&#169;&quot;,&quot;id&quot;:&quot;Ketuk di sini untuk chat&quot;,&quot;es-es&quot;:&quot;Toca aqu&#195;&#173; para chatear&quot;,&quot;es&quot;:&quot;Toca aqu&#195;&#173; para chatear&quot;,&quot;pt-br&quot;:&quot;Toque aqui para escrever&quot;,&quot;zh-cjv&quot;:&quot;&#232;&#189;&#187;&#231;&#130;&#185;&#230;&#173;&#164;&#229;&#164;&#132;&#228;&#187;&#165;&#232;&#129;&#138;&#229;&#164;&#169;&quot;,&quot;it&quot;:&quot;Tocca qui per chattare&quot;,&quot;fr&quot;:&quot;Touchez ici pour discuter&quot;,&quot;zh-cn&quot;:&quot;&#232;&#189;&#187;&#231;&#130;&#185;&#230;&#173;&#164;&#229;&#164;&#132;&#228;&#187;&#165;&#232;&#129;&#138;&#229;&#164;&#169;&quot;,&quot;ja&quot;:&quot;&#227;&#129;&#147;&#227;&#129;&#147;&#227;&#130;&#146;&#227;&#130;&#191;&#227;&#131;&#131;&#227;&#131;&#151;&#227;&#129;&#151;&#227;&#129;&#166;&#227;&#131;&#129;&#227;&#131;&#163;&#227;&#131;&#131;&#227;&#131;&#136;&#227;&#129;&#153;&#227;&#130;&#139;&quot;,&quot;th-th&quot;:&quot;&#224;&#185;&#129;&#224;&#184;&#149;&#224;&#184;&#176;&#224;&#184;&#151;&#224;&#184;&#181;&#224;&#185;&#136;&#224;&#184;&#153;&#224;&#184;&#181;&#224;&#185;&#136;&#224;&#185;&#128;&#224;&#184;&#158;&#224;&#184;&#183;&#224;&#185;&#136;&#224;&#184;&#173;&#224;&#185;&#129;&#224;&#184;&#138;&#224;&#184;&#151;&quot;,&quot;en-us&quot;:&quot;Tap here to chat&quot;,&quot;ko&quot;:&quot;&#236;&#151;&#172;&#234;&#184;&#176;&#235;&#165;&#188; &#237;&#129;&#180;&#235;&#166;&#173;&#237;&#149;&#156; &#237;&#155;&#132; &#235;&#130;&#180;&#236;&#154;&#169;&#236;&#157;&#132; &#236;&#158;&#133;&#235;&#160;&#165;&#237;&#149;&#152;&#236;&#132;&#184;&#236;&#154;&#148;&quot;}},{&quot;key&quot;:&quot;GameChat_ChatMain_ChatTranslationOnboarding&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;&#208;&#148;&#208;&#190;&#209;&#129;&#209;&#130;&#209;&#131;&#208;&#191;&#208;&#181;&#208;&#189; &#208;&#191;&#208;&#181;&#209;&#128;&#208;&#181;&#208;&#178;&#208;&#190;&#208;&#180; &#209;&#130;&#208;&#181;&#208;&#186;&#209;&#129;&#209;&#130;&#208;&#190;&#208;&#178;&#208;&#190;&#208;&#179;&#208;&#190; &#209;&#135;&#208;&#176;&#209;&#130;&#208;&#176;. &#208;&#157;&#208;&#176;&#208;&#182;&#208;&#188;&#208;&#184; &#208;&#189;&#208;&#176; &#209;&#129;&#208;&#184;&#208;&#188;&#208;&#178;&#208;&#190;&#208;&#187; &#208;&#191;&#208;&#181;&#209;&#128;&#208;&#181;&#208;&#180; &#209;&#129;&#208;&#190;&#208;&#190;&#208;&#177;&#209;&#137;&#208;&#181;&#208;&#189;&#208;&#184;&#208;&#181;&#208;&#188;, &#209;&#135;&#209;&#130;&#208;&#190;&#208;&#177;&#209;&#139; &#209;&#131;&#208;&#178;&#208;&#184;&#208;&#180;&#208;&#181;&#209;&#130;&#209;&#140; &#208;&#190;&#209;&#128;&#208;&#184;&#208;&#179;&#208;&#184;&#208;&#189;&#208;&#176;&#208;&#187;. &#208;&#159;&#208;&#181;&#209;&#128;&#208;&#181;&#208;&#178;&#208;&#190;&#208;&#180; &#208;&#188;&#208;&#190;&#208;&#182;&#208;&#189;&#208;&#190; &#208;&#190;&#209;&#130;&#208;&#186;&#208;&#187;&#209;&#142;&#209;&#135;&#208;&#184;&#209;&#130;&#209;&#140; &#208;&#178; &#208;&#157;&#208;&#176;&#209;&#129;&#209;&#130;&#209;&#128;&#208;&#190;&#208;&#185;&#208;&#186;&#208;&#176;&#209;&#133;.&quot;,&quot;pt&quot;:&quot;O chat de texto ser&#195;&#161; traduzido para seu idioma. Toque no s&#195;&#173;mbolo na frente da mensagem para ver o original. Voc&#195;&#170; pode desativar as tradu&#195;&#167;&#195;&#181;es no menu de configura&#195;&#167;&#195;&#181;es.&quot;,&quot;de&quot;:&quot;Der Textchat wird in deine Sprache &#195;&#188;bersetzt. Tippe auf das Symbol vor der Nachricht, um sie in der Originalsprache anzuzeigen. Du kannst &#195;&#156;bersetzungen im Men&#195;&#188; \&quot;Einstellungen\&quot; ausschalten.&quot;,&quot;zh-tw&quot;:&quot;&#230;&#150;&#135;&#229;&#173;&#151;&#228;&#186;&#164;&#232;&#171;&#135;&#230;&#156;&#131;&#231;&#191;&#187;&#232;&#173;&#175;&#231;&#130;&#186;&#230;&#130;&#168;&#230;&#133;&#163;&#231;&#148;&#168;&#231;&#154;&#132;&#232;&#170;&#158;&#232;&#168;&#128;&#227;&#128;&#130;&#232;&#171;&#139;&#232;&#188;&#149;&#232;&#167;&#184;&#232;&#168;&#138;&#230;&#129;&#175;&#229;&#137;&#141;&#231;&#154;&#132;&#231;&#172;&#166;&#232;&#153;&#159;&#239;&#188;&#140;&#230;&#159;&#165;&#231;&#156;&#139;&#229;&#142;&#159;&#230;&#150;&#135;&#227;&#128;&#130;&#230;&#130;&#168;&#229;&#143;&#175;&#228;&#187;&#165;&#229;&#156;&#168;&#227;&#128;&#140;&#232;&#168;&#173;&#229;&#174;&#154;&#227;&#128;&#141;&#233;&#129;&#184;&#229;&#150;&#174;&#233;&#151;&#156;&#233;&#150;&#137;&#231;&#191;&#187;&#232;&#173;&#175;&#227;&#128;&#130;&quot;,&quot;id&quot;:&quot;Chat teks akan diterjemahkan ke dalam bahasa kamu. Ketuk simbol di depan pesan untuk melihat pesan orisinal. Kamu dapat mematikan terjemahan di menu Pengaturan.&quot;,&quot;es-es&quot;:&quot;El chat de texto se traducir&#195;&#161; a tu idioma. Toca el s&#195;&#173;mbolo delante del mensaje para ver el original. Puedes desactivar las traducciones en el men&#195;&#186; Configuraci&#195;&#179;n.&quot;,&quot;es&quot;:&quot;El chat de texto se traducir&#195;&#161; a tu idioma. Toca el s&#195;&#173;mbolo delante del mensaje para ver el original. Puedes desactivar las traducciones en el men&#195;&#186; Configuraci&#195;&#179;n.&quot;,&quot;pt-br&quot;:&quot;O chat de texto ser&#195;&#161; traduzido para seu idioma. Toque no s&#195;&#173;mbolo na frente da mensagem para ver o original. Voc&#195;&#170; pode desativar as tradu&#195;&#167;&#195;&#181;es no menu de configura&#195;&#167;&#195;&#181;es.&quot;,&quot;zh-cjv&quot;:&quot;&#230;&#150;&#135;&#230;&#156;&#172;&#232;&#129;&#138;&#229;&#164;&#169;&#229;&#176;&#134;&#232;&#162;&#171;&#231;&#191;&#187;&#232;&#175;&#145;&#232;&#135;&#179;&#228;&#189;&#160;&#231;&#154;&#132;&#232;&#175;&#173;&#232;&#168;&#128;&#227;&#128;&#130;&#231;&#130;&#185;&#230;&#140;&#137;&#230;&#182;&#136;&#230;&#129;&#175;&#229;&#137;&#141;&#233;&#157;&#162;&#231;&#154;&#132;&#231;&#172;&#166;&#229;&#143;&#183;&#239;&#188;&#140;&#230;&#159;&#165;&#231;&#156;&#139;&#229;&#142;&#159;&#229;&#167;&#139;&#230;&#150;&#135;&#230;&#156;&#172;&#227;&#128;&#130; &#228;&#189;&#160;&#229;&#143;&#175;&#228;&#187;&#165;&#229;&#156;&#168;&#226;&#128;&#156;&#232;&#174;&#190;&#231;&#189;&#174;&#226;&#128;&#157;&#232;&#143;&#156;&#229;&#141;&#149;&#228;&#184;&#173;&#229;&#133;&#179;&#233;&#151;&#173;&#231;&#191;&#187;&#232;&#175;&#145;&#227;&#128;&#130;&quot;,&quot;it&quot;:&quot;La chat di testo verr&#195;&#160; tradotta nella tua lingua. Tocca il simbolo di fronte al messaggio per vedere l&apos;originale. Puoi disattivare le traduzioni nel menu Impostazioni.&quot;,&quot;fr&quot;:&quot;Le texte du chat sera traduit dans ta langue. Touche le symbole devant le message pour voir l&apos;original. Tu peux d&#195;&#169;sactiver les traductions dans le menu Param&#195;&#168;tres.&quot;,&quot;zh-cn&quot;:&quot;&#230;&#150;&#135;&#230;&#156;&#172;&#232;&#129;&#138;&#229;&#164;&#169;&#229;&#176;&#134;&#232;&#162;&#171;&#231;&#191;&#187;&#232;&#175;&#145;&#232;&#135;&#179;&#228;&#189;&#160;&#231;&#154;&#132;&#232;&#175;&#173;&#232;&#168;&#128;&#227;&#128;&#130;&#231;&#130;&#185;&#230;&#140;&#137;&#230;&#182;&#136;&#230;&#129;&#175;&#229;&#137;&#141;&#233;&#157;&#162;&#231;&#154;&#132;&#231;&#172;&#166;&#229;&#143;&#183;&#239;&#188;&#140;&#230;&#159;&#165;&#231;&#156;&#139;&#229;&#142;&#159;&#229;&#167;&#139;&#230;&#150;&#135;&#230;&#156;&#172;&#227;&#128;&#130; &#228;&#189;&#160;&#229;&#143;&#175;&#228;&#187;&#165;&#229;&#156;&#168;&#226;&#128;&#156;&#232;&#174;&#190;&#231;&#189;&#174;&#226;&#128;&#157;&#232;&#143;&#156;&#229;&#141;&#149;&#228;&#184;&#173;&#229;&#133;&#179;&#233;&#151;&#173;&#231;&#191;&#187;&#232;&#175;&#145;&#227;&#128;&#130;&quot;,&quot;ja&quot;:&quot;&#227;&#131;&#134;&#227;&#130;&#173;&#227;&#130;&#185;&#227;&#131;&#136;&#227;&#131;&#129;&#227;&#131;&#163;&#227;&#131;&#131;&#227;&#131;&#136;&#227;&#129;&#140;&#232;&#168;&#173;&#229;&#174;&#154;&#232;&#168;&#128;&#232;&#170;&#158;&#227;&#129;&#171;&#231;&#191;&#187;&#232;&#168;&#179;&#227;&#129;&#149;&#227;&#130;&#140;&#227;&#129;&#190;&#227;&#129;&#153;&#227;&#128;&#130;&#229;&#142;&#159;&#230;&#150;&#135;&#227;&#130;&#146;&#232;&#166;&#139;&#227;&#130;&#139;&#227;&#129;&#171;&#227;&#129;&#175;&#227;&#128;&#129;&#227;&#131;&#161;&#227;&#131;&#131;&#227;&#130;&#187;&#227;&#131;&#188;&#227;&#130;&#184;&#227;&#129;&#174;&#229;&#137;&#141;&#227;&#129;&#171;&#227;&#129;&#130;&#227;&#130;&#139;&#231;&#191;&#187;&#232;&#168;&#179;&#227;&#131;&#158;&#227;&#131;&#188;&#227;&#130;&#175;&#227;&#130;&#146;&#227;&#130;&#191;&#227;&#131;&#131;&#227;&#131;&#151;&#227;&#129;&#151;&#227;&#129;&#166;&#227;&#129;&#143;&#227;&#129;&#160;&#227;&#129;&#149;&#227;&#129;&#132;&#227;&#128;&#130;&#231;&#191;&#187;&#232;&#168;&#179;&#227;&#129;&#175;&#232;&#168;&#173;&#229;&#174;&#154;&#227;&#131;&#161;&#227;&#131;&#139;&#227;&#131;&#165;&#227;&#131;&#188;&#227;&#129;&#167;&#227;&#130;&#170;&#227;&#131;&#149;&#227;&#129;&#171;&#227;&#129;&#167;&#227;&#129;&#141;&#227;&#129;&#190;&#227;&#129;&#153;&#227;&#128;&#130;&quot;,&quot;th-th&quot;:&quot;&#224;&#184;&#130;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&#224;&#185;&#131;&#224;&#184;&#153;&#224;&#185;&#129;&#224;&#184;&#138;&#224;&#184;&#151;&#224;&#184;&#136;&#224;&#184;&#176;&#224;&#185;&#132;&#224;&#184;&#148;&#224;&#185;&#137;&#224;&#184;&#163;&#224;&#184;&#177;&#224;&#184;&#154;&#224;&#184;&#129;&#224;&#184;&#178;&#224;&#184;&#163;&#224;&#185;&#129;&#224;&#184;&#155;&#224;&#184;&#165;&#224;&#185;&#128;&#224;&#184;&#155;&#224;&#185;&#135;&#224;&#184;&#153;&#224;&#184;&#160;&#224;&#184;&#178;&#224;&#184;&#169;&#224;&#184;&#178;&#224;&#184;&#130;&#224;&#184;&#173;&#224;&#184;&#135;&#224;&#184;&#132;&#224;&#184;&#184;&#224;&#184;&#147; &#224;&#185;&#129;&#224;&#184;&#149;&#224;&#184;&#176;&#224;&#184;&#170;&#224;&#184;&#177;&#224;&#184;&#141;&#224;&#184;&#165;&#224;&#184;&#177;&#224;&#184;&#129;&#224;&#184;&#169;&#224;&#184;&#147;&#224;&#185;&#140;&#224;&#184;&#171;&#224;&#184;&#153;&#224;&#185;&#137;&#224;&#184;&#178;&#224;&#184;&#130;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&#224;&#185;&#128;&#224;&#184;&#158;&#224;&#184;&#183;&#224;&#185;&#136;&#224;&#184;&#173;&#224;&#184;&#148;&#224;&#184;&#185;&#224;&#184;&#130;&#224;&#185;&#137;&#224;&#184;&#173;&#224;&#184;&#132;&#224;&#184;&#167;&#224;&#184;&#178;&#224;&#184;&#161;&#224;&#185;&#131;&#224;&#184;&#153;&#224;&#184;&#160;&#224;&#184;&#178;&#224;&#184;&#169;&#224;&#184;&#178;&#224;&#184;&#149;&#224;&#185;&#137;&#224;&#184;&#153;&#224;&#184;&#137;&#224;&#184;&#154;&#224;&#184;&#177;&#224;&#184;&#154; &#224;&#184;&#132;&#224;&#184;&#184;&#224;&#184;&#147;&#224;&#184;&#170;&#224;&#184;&#178;&#224;&#184;&#161;&#224;&#184;&#178;&#224;&#184;&#163;&#224;&#184;&#150;&#224;&#184;&#155;&#224;&#184;&#180;&#224;&#184;&#148;&#224;&#184;&#129;&#224;&#184;&#178;&#224;&#184;&#163;&#224;&#185;&#129;&#224;&#184;&#155;&#224;&#184;&#165;&#224;&#184;&#160;&#224;&#184;&#178;&#224;&#184;&#169;&#224;&#184;&#178;&#224;&#185;&#132;&#224;&#184;&#148;&#224;&#185;&#137;&#224;&#185;&#131;&#224;&#184;&#153;&#224;&#185;&#128;&#224;&#184;&#161;&#224;&#184;&#153;&#224;&#184;&#185;&#224;&#184;&#129;&#224;&#184;&#178;&#224;&#184;&#163;&#224;&#184;&#149;&#224;&#184;&#177;&#224;&#185;&#137;&#224;&#184;&#135;&#224;&#184;&#132;&#224;&#185;&#136;&#224;&#184;&#178;&quot;,&quot;en-us&quot;:&quot;Text chat will be translated into your language. Tap the symbol in front of the message to see the original. You can turn off translations in the Settings menu.&quot;,&quot;ko&quot;:&quot;&#237;&#133;&#141;&#236;&#138;&#164;&#237;&#138;&#184; &#236;&#177;&#132;&#237;&#140;&#133;&#236;&#157;&#180; &#236;&#130;&#172;&#236;&#154;&#169;&#236;&#158;&#144;&#236;&#157;&#152; &#236;&#150;&#184;&#236;&#150;&#180;&#235;&#161;&#156; &#235;&#178;&#136;&#236;&#151;&#173;&#235;&#144;&#169;&#235;&#139;&#136;&#235;&#139;&#164;. &#235;&#169;&#148;&#236;&#139;&#156;&#236;&#167;&#128; &#236;&#149;&#158;&#236;&#157;&#152; &#234;&#184;&#176;&#237;&#152;&#184;&#235;&#165;&#188; &#237;&#131;&#173;&#237;&#149;&#152;&#235;&#169;&#180; &#236;&#157;&#180;&#235;&#165;&#188; &#236;&#155;&#144;&#235;&#158;&#152; &#236;&#150;&#184;&#236;&#150;&#180;&#235;&#161;&#156; &#237;&#153;&#149;&#236;&#157;&#184;&#237;&#149;&#160; &#236;&#136;&#152; &#236;&#158;&#136;&#236;&#138;&#181;&#235;&#139;&#136;&#235;&#139;&#164;. &#236;&#132;&#164;&#236;&#160;&#149; &#235;&#169;&#148;&#235;&#137;&#180;&#236;&#151;&#144;&#236;&#132;&#156; &#235;&#178;&#136;&#236;&#151;&#173; &#234;&#184;&#176;&#235;&#138;&#165;&#236;&#157;&#132; &#235;&#129;&#140; &#236;&#136;&#152; &#236;&#158;&#136;&#236;&#138;&#181;&#235;&#139;&#136;&#235;&#139;&#164;.&quot;}},{&quot;key&quot;:&quot;GameChat_ChatMain_SpeakerHasBeenBlocked&quot;,&quot;values&quot;:{&quot;ru&quot;:&quot;&#208;&#159;&#208;&#190;&#208;&#187;&#209;&#140;&#208;&#183;&#208;&#190;&#208;&#178;&#208;&#176;&#209;&#130;&#208;&#181;&#208;&#187;&#209;&#140; {RBX_NAME} &#208;&#183;&#208;&#176;&#208;&#177;&#208;&#187;&#208;&#190;&#208;&#186;&#208;&#184;&#209;&#128;&#208;&#190;&#208;&#178;&#208;&#176;&#208;&#189;.&quot;,&quot;pt&quot;:&quot;O usu&#195;&#161;rio &apos;{RBX_NAME}&apos; foi bloqueado(a).&quot;,&quot;de&quot;:&quot;Sprecher:in &#226;&#128;&#158;{RBX_NAME}&#226;&#128;&#156; wurde blockiert.&quot;,&quot;zh-tw&quot;:&quot;&#229;&#183;&#178;&#229;&#176;&#129;&#233;&#142;&#150;&#228;&#189;&#191;&#231;&#148;&#168;&#232;&#128;&#133;&#227;&#128;&#140;{RBX_NAME}&#227;&#128;&#141;&#227;&#128;&#130;&quot;,&quot;id&quot;:&quot;Pembicara {RBX_NAME} telah diblokir.&quot;,&quot;es-es&quot;:&quot;Se bloque&#195;&#179; al usuario \&quot;{RBX_NAME}\&quot;.&quot;,&quot;es&quot;:&quot;Se bloque&#195;&#179; al usuario \&quot;{RBX_NAME}\&quot;.&quot;,&quot;pt-br&quot;:&quot;O usu&#195;&#161;rio &apos;{RBX_NAME}&apos; foi bloqueado(a).&quot;,&quot;zh-cjv&quot;:&quot;&#229;&#143;&#145;&#232;&#168;&#128;&#232;&#128;&#133;&#226;&#128;&#156;{RBX_NAME}&#226;&#128;&#157;&#229;&#183;&#178;&#232;&#162;&#171;&#229;&#177;&#143;&#232;&#148;&#189;&#227;&#128;&#130;&quot;,&quot;it&quot;:&quot;Hai bloccato il giocatore \&quot;{RBX_NAME}\&quot;.&quot;,&quot;fr&quot;:&quot;L&apos;interlocuteur {RBX_NAME} a &#195;&#169;t&#195;&#169; bloqu&#195;&#169;.&quot;,&quot;zh-cn&quot;:&quot;&#229;&#143;&#145;&#232;&#168;&#128;&#232;&#128;&#133;&#226;&#128;&#156;{RBX_NAME}&#226;&#128;&#157;&#229;&#183;&#178;&#232;&#162;&#171;&#229;&#177;&#143;&#232;&#148;&#189;&#227;&#128;&#130;&quot;,&quot;ja&quot;:&quot;&#227;&#130;&#185;&#227;&#131;&#148;&#227;&#131;&#188;&#227;&#130;&#171;&#227;&#131;&#188;&#227;&#129;&#174;&#227;&#128;&#140;{RBX_NAME}&#227;&#128;&#141;&#