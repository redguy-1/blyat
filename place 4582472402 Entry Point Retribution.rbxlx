41;&#231;&#168;&#177;&gt; &#230;&#136;&#150; /w &lt;&#228;&#189;&#191;&#231;&#148;&#168;&#232;&#128;&#133;&#229;&#144;&#141;&#231;&#168;&#177;&gt; : &#232;&#136;&#135;&#230;&#173;&#164;&#228;&#189;&#191;&#231;&#148;&#168;&#232;&#128;&#133;&#233;&#150;&#139;&#229;&#149;&#159;&#231;&#167;&#129;&#228;&#186;&#186;&#232;&#168;&#138;&#230;&#129;&#175;&#233;&#160;&#187;&#233;&#129;&#147;&#227;&#128;&#130;&quot;,&quot;id&quot;:&quot;/whisper &lt;speaker&gt; atau /w &lt;speaker&gt; : buka channel pesan privat dengan pembicara.&quot;,&quot;es-es&quot;:&quot;/whisper &lt;usuario&gt; o /w &lt;usuario&gt;: abrir canal de mensajes privados con un usuario.&quot;,&quot;es&quot;:&quot;/whisper &lt;usuario&gt; o /w &lt;usuario&gt;: abrir canal de mensajes privados con un usuario.&quot;,&quot;pt-br&quot;:&quot;/whisper &lt;speaker&gt; ou /w &lt;speaker&gt; : abrir um canal de mensagem privada com uma pessoa.&quot;,&quot;zh-cjv&quot;:&quot;/whisper &lt;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#144;&#141;&#231;&#167;&#176;&gt; &#230;&#136;&#150; /w &lt;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#144;&#141;&#231;&#167;&#176;&gt; : &#228;&#184;&#142;&#230;&#173;&#164;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#188;&#128;&#229;&#144;&#175;&#231;&#167;&#129;&#228;&#186;&#186;&#230;&#182;&#136;&#230;&#129;&#175;&#233;&#162;&#145;&#233;&#129;&#147;&#227;&#128;&#130;&quot;,&quot;it&quot;:&quot;/whisper &lt;giocatore&gt; o /w &lt;giocatore&gt;: apri un canale privato con un giocatore.&quot;,&quot;fr&quot;:&quot;/whisper &lt;interlocuteur&gt; ou /w &lt;interlocuteur&gt;&#194;&#160;: ouvre un canal de discussion priv&#195;&#169; avec l&apos;interlocuteur.&quot;,&quot;zh-cn&quot;:&quot;/whisper &lt;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#144;&#141;&#231;&#167;&#176;&gt; &#230;&#136;&#150; /w &lt;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#144;&#141;&#231;&#167;&#176;&gt; : &#228;&#184;&#142;&#230;&#173;&#164;&#231;&#148;&#168;&#230;&#136;&#183;&#229;&#188;&#128;&#229;&#144;&#175;&#231;&#167;